#!/bin/sh
# =============================================================================
# qmanager_dns_apply — the only writer of the smartdns config on this device
# =============================================================================
# Runs as ROOT (sudo -n from the CGI, or directly from the refresh timer).
#
# WHY A PRIVILEGED HELPER EXISTS AT ALL
#   The config is read by a root daemon, and the web user must never be able to
#   name a path that daemon reads. The CGI therefore passes config TEXT on stdin;
#   every filesystem decision (destination, backup, temp name) is made HERE. This
#   mirrors the reasoning already recorded for /etc/qmanager.env in
#   scripts/etc/systemd/system/qmanager-ping.service: a www-data-owned directory
#   lets the web user replace ANY file in it, so a web-writable file feeding a
#   root daemon is privilege escalation.
#
# WHY VALIDATION IS A PORT RUN, NOT `smartdns test -c`
#   `smartdns test -c` VALIDATES NOTHING on 0.13.1. Measured (sibling repo
#   dns.md:489, re-confirmed here): it exits 0 for `totally-bogus-directive foo`,
#   `speed-check-mode bogusmode` and `bind not-a-port`, and unknown directives are
#   silently ignored. Gating a deploy on it would ship a broken resolver and call
#   it validated. The real gate is: start the CANDIDATE on a throwaway loopback
#   port, assert it LISTENS and ANSWERS, and only then swap it in.
#
# ORDER OF OPERATIONS (never reorder — the safety rests on it)
#   1. write candidate to a temp file on the same volume as the target
#   2. run candidate on the throwaway port; assert listening + answers a control
#      name; kill it either way
#   3. only if (2) passed: back up the live file to .pre-qmanager, atomic mv
#   4. restart the unit, then assert 127.0.0.1:5353 is listening AND the LAN
#      resolver (dnsmasq -> us) still answers
#   5. if (4) failed: restore the backup, restart again, verify, report rollback
#
# ACTIONS
#   apply-edge            regenerate the EDGE block from measured provider quality
#   save                  validate+apply config text read from stdin
#   enable | disable      start/stop the unit (dnsmasq strict-order falls back to
#                         the carrier resolvers, so DNS keeps working when off)
#
# Exit codes: 0 ok · 1 refused/failed (message on stdout as JSON) · 2 bad usage
# =============================================================================
set -u

QM_ROOT=${QM_ROOT:-/usrdata/qmanager}
BIN=${SMARTDNS_BIN:-$QM_ROOT/bin/smartdns}
CONF=${SMARTDNS_CONF:-$QM_ROOT/etc/smartdns.conf}
NEW="$CONF.new"
BAK="$CONF.pre-qmanager"
UNIT=${DNS_UNIT:-qmanager-dns.service}
PORT=${VALIDATE_PORT:-15353}
CTRL_NAME=${CONTROL_NAME:-debian.org}
CTRL_IP=${CONTROL_IP:-151.101.2.132}
LISTEN_PORT=5353
LAN_RESOLVER=${LAN_RESOLVER:-192.168.0.1}

PROBE="$QM_ROOT/bin/qmanager_dns_edge_probe"
EDGE_BEGIN="# BEGIN QMANAGER-EDGE v1 (generated by qmanager_dns_apply -- do not hand-edit)"
EDGE_END="# END QMANAGER-EDGE v1"

log() { printf '%s\n' "$*" >&2; }
# JSON out: single object on stdout, so the CGI can pass it through.
out() { printf '%s\n' "$1"; }

# --- helper: is anything listening on a loopback port? -----------------------
listening() {
    netstat -lnu 2>/dev/null | grep -q "127.0.0.1:$1"
}

# --- helper: does the candidate answer a known name on the scratch port? ------
# The answer is NOT compared to an IP (CDNs rotate); we only require NOERROR with
# at least one A record, which is enough to prove the directive set is serviceable.
#
# RETRIES, because the candidate is COLD. Measured 2026-10-24: a fresh instance
# needs bootstrap + a DoH race for its first name, which regularly exceeds a 2 s
# budget — and a validation that fails on a slow-but-correct config is worse than
# useless: it blocks the refresh and leaves the old block in place. Three attempts
# at 4 s each still sits inside the caller's timeout.
answers() {
    _a=0
    while [ "$_a" -lt 3 ]; do
        _r=$(dig +short +time=4 +tries=1 @127.0.0.1 -p "$1" "$CTRL_NAME" 2>/dev/null | grep -cE '^[0-9]')
        [ "${_r:-0}" -ge 1 ] && return 0
        _a=$((_a + 1))
        [ "$_a" -lt 3 ] && sleep 2
    done
    return 1
}

# --- helper: kill just the scratch instance, matched by process NAME ----------
# Deliberately not `pkill -f <path>`: the pattern also matches the caller's own
# command line over SSH, which kills the invoking session (AGENTS.md hard rule 5,
# observed here twice).
kill_scratch() {
    for _p in /proc/[0-9]*; do
        _pid=${_p#/proc/}
        [ "$(cat "$_p/comm" 2>/dev/null)" = "smartdns" ] || continue
        _c=$(tr '\0' ' ' < "$_p/cmdline" 2>/dev/null) || continue
        case "$_c" in *"$1"*) kill "$_pid" 2>/dev/null ;; esac
    done
}

# --- validation gate --------------------------------------------------------
# $1 = candidate config path. Returns 0 only if it serves on the scratch port.
validate_candidate() {
    _cand=$1
    [ -f "$_cand" ] || { log "validate: no candidate"; return 1; }

    # The candidate's own bind line must be the intended one; only the throwaway
    # run may bind elsewhere. Checked BEFORE rewriting so a bad bind is caught.
    if ! grep -qE "^bind[[:space:]]+127\.0\.0\.1:$LISTEN_PORT$" "$_cand"; then
        log "validate: candidate does not bind 127.0.0.1:$LISTEN_PORT"
        return 1
    fi

    if listening "$PORT"; then
        log "validate: scratch port $PORT already in use; refusing"
        return 1
    fi

    _dir=/tmp/qm_dnsval.$$
    rm -rf "$_dir"; mkdir -p "$_dir" || return 1
    sed -e "s|^bind .*|bind 127.0.0.1:$PORT|" \
        -e "s|/tmp/smartdns.cache|$_dir/c.cache|" \
        -e "s|/tmp/smartdns.log|$_dir/c.log|" "$_cand" > "$_dir/cand.conf"

    nohup "$BIN" run -c "$_dir/cand.conf" >"$_dir/out" 2>&1 &
    _i=0
    while [ "$_i" -lt 10 ]; do
        listening "$PORT" && break
        sleep 1; _i=$((_i + 1))
    done

    _ok=1
    if ! listening "$PORT"; then
        log "validate: candidate never bound $PORT (see $_dir/out)"
        _ok=0
    elif ! answers "$PORT"; then
        log "validate: candidate bound but does not answer $CTRL_NAME"
        _ok=0
    fi

    kill_scratch "$_dir/cand.conf"
    sleep 1
    # Keep the scratch log on failure for diagnosis; drop it on success.
    if [ "$_ok" -eq 1 ]; then
        rm -rf "$_dir"
        return 0
    fi
    return 1
}

# --- apply a validated candidate: backup, swap, restart, verify, roll back ----
apply_validated() {
    _cand=$1
    [ -f "$CONF" ] && cp -f "$CONF" "$BAK"

    mv -f "$_cand" "$CONF" || { out '{"ok":false,"error":"swap_failed"}'; return 1; }
    chmod 600 "$CONF"

    systemctl restart "$UNIT" >/dev/null 2>&1
    _i=0
    while [ "$_i" -lt 15 ]; do
        listening "$LISTEN_PORT" && break
        sleep 1; _i=$((_i + 1))
    done

    if ! listening "$LISTEN_PORT"; then
        log "apply: unit did not bind $LISTEN_PORT; rolling back"
        if [ -f "$BAK" ]; then
            cp -f "$BAK" "$CONF"; chmod 600 "$CONF"
            systemctl restart "$UNIT" >/dev/null 2>&1
            _i=0
            while [ "$_i" -lt 15 ]; do listening "$LISTEN_PORT" && break; sleep 1; _i=$((_i + 1)); done
        fi
        if listening "$LISTEN_PORT"; then
            out '{"ok":false,"error":"restart_failed","rolled_back":true}'
        else
            out '{"ok":false,"error":"restart_failed","rolled_back":false,"note":"dnsmasq still falls back to carrier"}'
        fi
        return 1
    fi

    # The path that actually matters to clients: dnsmasq on the LAN address.
    if ! dig +short +time=2 +tries=1 @"$LAN_RESOLVER" "$CTRL_NAME" 2>/dev/null | grep -qE '^[0-9]'; then
        log "apply: listening but the LAN resolver is not answering yet"
    fi

    # Ledger for the UI's "last refresh" and the applied member list. tmpfs on
    # purpose: it describes THIS boot's decision, and a stale copy from a previous
    # boot would claim a refresh that never happened.
    if [ -n "${_LEDGER_JSON:-}" ]; then
        printf '%s\n' "$_LEDGER_JSON" > /tmp/qmanager_dns_edge.json 2>/dev/null || true
    fi
    out '{"ok":true,"restarted":true,"listening":true}'
    return 0
}

# --- edge block regeneration from measured provider quality -------------------
# Reads the probe's recommendation on stdin. Rewrites only the sentinel block, so
# hand-written cache/TTL/pool tuning above it is preserved verbatim.
build_edge_candidate() {
    _json=$1
    _action=$(printf '%s' "$_json" | jq -r '.recommendation.action // "keep"')
    if [ "$_action" != "rewrite" ]; then
        return 1
    fi
    _good=$(printf '%s' "$_json" | jq -r '.recommendation.good[]? // empty')
    _domains=$(printf '%s' "$_json" | jq -r '.probe_domains[]? // empty')
    [ -n "$_good" ] || return 1

    # Everything except an existing generated block, verbatim.
    awk -v b="$EDGE_BEGIN" -v e="$EDGE_END" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip
    ' "$CONF" > "$NEW" || return 1

    {
        printf '%s\n' "$EDGE_BEGIN"
        printf '# Generated from measured provider quality. Do not hand-edit:\n'
        printf '# qmanager-dns-edge.timer regenerates it. Drop an entry here and the\n'
        printf '# next refresh puts it back if it is still measured good.\n'
        for _u in $_good; do
            printf 'server %s -group edge -exclude-default-group\n' "$_u"
        done
        for _d in $_domains; do
            printf 'nameserver /%s/edge\n' "$_d"
        done
        printf '%s\n' "$EDGE_END"
    } >> "$NEW"

    return 0
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in

apply-edge)
    _LEDGER_JSON=""
    [ -x "$PROBE" ] || { out '{"ok":false,"error":"probe_missing"}'; exit 1; }
    _j=$("$PROBE" --json 2>/dev/null)
    [ -n "$_j" ] || { out '{"ok":false,"error":"probe_failed"}'; exit 1; }

    if ! build_edge_candidate "$_j"; then
        _why=$(printf '%s' "$_j" | jq -r '.recommendation.action // "keep"')
        printf '{"ok":true,"applied":false,"action":"%s"}\n' "$_why"
        exit 0
    fi

    _LEDGER_JSON=$(printf '%s' "$_j" | jq -c --argjson now "$(date +%s)" \
        '{ts: $now, members: .recommendation.good, domains: .probe_domains,
          threshold_ms: .threshold_ms,
          providers: [.providers[] | {short, quality_ms, verdict}]}')

    if ! validate_candidate "$NEW"; then
        rm -f "$NEW"
        echo '{"ok":false,"error":"validation_failed","applied":false}'
        exit 1
    fi
    apply_validated "$NEW"
    exit $?
    ;;

save)
    # Config text arrives on stdin from the CGI — never a path.
    cat > "$NEW"
    [ -s "$NEW" ] || { rm -f "$NEW"; out '{"ok":false,"error":"empty_config"}'; exit 1; }
    # No ledger update on a hand-save: the operator's config is not a measurement,
    # and claiming a refresh happened because someone pasted text would make the
    # UI's "last measured" figure lie.
    _LEDGER_JSON=""
    if ! validate_candidate "$NEW"; then
        rm -f "$NEW"
        # The validator's stderr is the detail the UI shows verbatim.
        out '{"ok":false,"error":"validation_failed","detail":"candidate did not serve on the throwaway port; see /tmp/qm_dnsval.*"}'
        exit 1
    fi
    apply_validated "$NEW"
    exit $?
    ;;

enable)
    systemctl start "$UNIT" >/dev/null 2>&1
    _i=0; while [ "$_i" -lt 15 ]; do listening "$LISTEN_PORT" && break; sleep 1; _i=$((_i + 1)); done
    if listening "$LISTEN_PORT"; then
        out '{"ok":true,"enabled":true,"running":true}'; exit 0
    fi
    out '{"ok":false,"error":"bind_failed","running":false}'; exit 1
    ;;

disable)
    # Stop only. dnsmasq's strict-order already falls through to the carrier
    # resolvers, so DNS keeps working — degraded, not broken. No dnsmasq edit.
    systemctl stop "$UNIT" >/dev/null 2>&1
    sleep 1
    if listening "$LISTEN_PORT"; then
        out '{"ok":false,"error":"still_listening"}'; exit 1
    fi
    out '{"ok":true,"enabled":false,"running":false,"fallback":"carrier"}'; exit 0
    ;;

*)
    echo 'usage: qmanager_dns_apply {apply-edge|save|enable|disable}' >&2
    exit 2
    ;;
esac
