#!/bin/bash
# =============================================================================
# qmanager_poller — QManager Background Poller Daemon
# =============================================================================
# Continuously gathers modem data and system metrics, writes to the
# JSON state cache at /tmp/qmanager_status.json.
#
# Strategy: "Sip, Don't Gulp"
#   - Acquire lock → run ONE AT command → release → sleep → repeat
#   - Leaves gaps for terminal/watchdog to access the modem
#
# Tiers:
#   Tier 1 (Hot):    Every cycle        — AT+QENG="servingcell", AT+QCAINFO, /proc reads
#   Tier 1.5 (Signal): Every 5 cycles       — AT+QRSRP, AT+QRSRQ, AT+QSINR
#   Tier 2 (Warm):   Every 15 cycles    — AT+QTEMP, AT+COPS?, AT+CPIN?, AT+QUIMSLOT?,
#                                         AT+QNWCFG="*_time_advance",
#                                         AT+QNWCFG="*_mimo_layers" (network-mode-gated),
#                                         AT+CGCONTRDP, AT+QMAP="WWAN"
#   Tier 3 (PHY):    Every TIER3_EVERY cycles (~60s) — PHY layer via
#                    lib/qmanager/phy_metrics.sh: one `ubus call modemd status`
#                    (no AT lock) + TWO compound AT reads (CQI/RI/PMI, MIMO
#                    layers, MCS, TM mode, RRC state, NR TX power, SSB beams).
#                    Published as `phy` in the status cache and appended to
#                    /usrdata/qmanager/metrics/YYYY-MM-DD.csv.
#                    Runs AFTER the cycle budget timer (see main), so it can
#                    never move the Tier-1 measurement.
#
#   AT+QCAINFO is TIER 1, not Tier 2. Its read sits at the top of the cycle body
#   (see below), ABOVE the Tier 2 gate, and is unconditional. Earlier revisions of
#   this header and docs/reference/carrier-aggregation.md both listed it as
#   "every 15 cycles"; that was never true of the code.
#
#   Cycle cadence is ~3.7-4.0s, NOT the ~2s POLL_INTERVAL suggests: the sleep runs
#   AFTER the cycle body, so the period is the body's own duration plus the sleep.
#   Measured across 103 consecutive polls on the live device. Any interval derived
#   from POLL_INTERVAL alone is roughly 50% short.
#   Boot-only:     Once at startup    — AT+CVERSION, AT+CGSN, AT+CIMI, AT+QCCID,
#                                       AT+CNUM, AT+QGETCAPABILITY,
#                                       AT+QNWPREFCFG="policy_band"
#
#   Neighbour live (QMI, lease-gated): once per cycle while a browser holds
#   /tmp/qmanager_neighbours_live — one LTE neighbour read + one signal read over
#   QMI, published atomically to /tmp/qmanager_neighbours_live.json. QMI is a
#   separate pipe from the AT port, so this takes no qcmd and no AT lock and
#   cannot starve Tier 1; it is called AFTER the cycle's budget timer (see main)
#   so a slow QMI answer can never move that measurement either. With no lease
#   it does nothing at all.
#
# Libraries (sourced at startup):
#   /usr/lib/qmanager/qlog.sh      — Centralized logging
#   /usr/lib/qmanager/hw_profile.sh — Hardware identity (model / SoC) parser
#   /usr/lib/qmanager/parse_at.sh  — AT command response parsers
#   /usr/lib/qmanager/events.sh    — Network event detection
#   /usr/lib/qmanager/qmi_read.sh  — Read-only QMI (neighbour cells / signal)
#   /usr/lib/qmanager/phy_metrics.sh — Read-only PHY layer (CQI/RI/MCS/beams) + archive
#
# Install location: /usr/bin/qmanager_poller
# =============================================================================

# --- Configuration -----------------------------------------------------------
CACHE_FILE="/tmp/qmanager_status.json"
CACHE_TMP="/tmp/qmanager_status.json.tmp"
LONG_FLAG="/tmp/qmanager_long_running"
# Touched by external triggers (e.g. SIM-slot-change CGI) to pull the warm
# refresh into the next cycle instead of waiting up to ~30s for the normal
# Tier 2 cadence to land.
TIER2_REFRESH_FLAG="/tmp/qmanager_tier2_refresh"
POLL_INTERVAL=2        # seconds between Tier 1 cycles
# Fixed cycle PERIOD (start to start) while no live-neighbour lease is held.
# Before this the period was "cycle body + POLL_INTERVAL", so it floated with
# AT latency: 8.4 s on the RG520N-EB when one AT read was timing out, 4.35 s
# once it was fixed — nobody chose either, and the CPU share moved with it.
# POLL_INTERVAL stays the MINIMUM gap, so CGIs always get the AT port between
# cycles. Override with Environment=POLL_PERIOD=<s> in the unit.
# Measured 2026-10-22: see docs/reference/poller-cpu-profile.md "Round 3".
POLL_PERIOD="${POLL_PERIOD:-5}"
case "$POLL_PERIOD" in ''|*[!0-9]*) POLL_PERIOD=5 ;; esac
TIER1_5_EVERY=5        # Tier 1.5 (per-antenna signal) runs every N cycles (10s)
TIER2_EVERY=15         # Tier 2 runs every N cycles
# Tier 3 (PHY depth) cadence, in cycles LIKE the two above, not in seconds:
# a cycle is 3.7-4.0s measured (see the header), NOT the 2s POLL_INTERVAL, so 15
# cycles is the ~60s the spec asks for. Tunable: the only outside cost per run is
# two AT lock holds in `phy_metrics.sh`, and the interval is the knob for it.
TIER3_EVERY=15
CYCLE_TIME_BUDGET=10   # seconds; warn if poll_cycle exceeds this

# resolve_network_iface — the netdev whose /proc/net/dev byte counters feed the
# persistent Data Used counter. Returns "rmnet_ipa0" on every device this
# daemon can run on.
#
# This used to branch on `[ -f /etc/quectel-project-version ]`, choosing the
# legacy OpenWRT netdev when the vendor file was absent. That discriminator is
# gone, for two reasons. The vendor file is present on both live targets, so
# the branch already resolved the same way everywhere it could actually run;
# and rmnet_ipa0 is the aggregate WAN netdev on BOTH SDX55 and SDX65
# (docs/reference/data-counter-platform-matrix.md:41,62,141), so there was
# never a second answer to give. The OpenWRT sibling lives in a different repo
# and its tier is `incompatible` — the installer refuses to run there at all.
#
# THE FALLBACK IS NAMED HERE ON PURPOSE (convention C5), because the failure
# mode is invisible. If this ever resolves to a netdev that is not in
# /proc/net/dev, the `grep "${NETWORK_IFACE}:"` in update_data_used returns
# empty, the tick bails before touching any state, and Data Used silently stops
# accumulating FOREVER while the status JSON keeps emitting a plausible frozen
# accumulated_rx_bytes. Nothing observable goes red.
#
# Per-device netdev selection belongs in the hardware profile's `caps` in
# Phase C, not in a model glob here. It is a function rather than a bare
# assignment so the choice can be driven from scripts/test/poller-data-used.sh.
resolve_network_iface() {
    printf '%s\n' "rmnet_ipa0"
}
NETWORK_IFACE=$(resolve_network_iface)
# Path to the Quectel firmware version file. Overridable for the test harness.
: "${QUECTEL_VERSION_FILE:=/etc/quectel-project-version}"

# detect_orientation_from_soc — the /proc/net/dev field orientation for this
# SoC. Output: "reversed" | "normal" (printed to stdout).
#
# The SoC read goes through hw_profile.sh. It used to be a grep hand-rolled
# here, and that grep was WRONG: it looked for a single space in a label the
# vendor file column-aligns with two. It matched nothing on any real device, so
# this function returned "normal" everywhere, always — by accident rather than
# by decision. One tolerant parser, in one place, is the whole point of the
# library.
#
# EVERY SoC RESOLVES TO "normal", INCLUDING SDX55 — DELIBERATELY.
#
# Repairing the parser makes this function work for the first time in its life,
# which would activate an SDX55 map that no measurement supports. Worse than
# unsupported: docs/reference/data-counter-platform-matrix.md:141 records an
# SDX55 part (RM502Q-AE) probing NORMAL, contradicting the map further down the
# same file. Fielded RM502Q-AE / RG502Q community devices report SDX55 and
# would flip. Measuring that map is Phase B's job; the arm below is inert on
# purpose, and pinned inert by scripts/test/poller-data-used.sh. Do not
# "finish" it without a measurement to point at.
#
# If hw_profile.sh is not loaded (partial install, mid-OTA, rollback) qm_hw_soc
# does not exist and $soc stays empty — which lands on exactly the same answer
# every device has ever produced.
detect_orientation_from_soc() {
    local soc=""
    command -v qm_hw_soc >/dev/null 2>&1 && soc=$(qm_hw_soc)
    case "$soc" in
        # SDX55) echo "reversed" ;;   # PHASE-B GATED — unmeasured, see above
        *) echo "normal" ;;
    esac
}

SIP_DELAY=0.1          # Delay between AT commands (seconds)
LONG_FLAG_MAX_AGE=300  # seconds; auto-clear stale long-running flags

# --- Neighbour live view (QMI) -----------------------------------------------
# Lease : /tmp/qmanager_neighbours_live — one epoch, written by the CGI
#         (neighbour_scan_status.sh?range=now) as www-data. This daemon only
#         ever READS it and trusts nothing but digits: the shape qmanager_sites
#         uses for its own live lease.
# Live  : /tmp/qmanager_neighbours_live.json — written here, atomically (temp +
#         mv), never by the CGI. tmpfs; regenerated, never durable state.
NEIGHBOURS_LIVE_LEASE="/tmp/qmanager_neighbours_live"
NEIGHBOURS_LIVE_FILE="/tmp/qmanager_neighbours_live.json"
NEIGHBOURS_LIVE_LEASE_SEC=10   # live ticks run while the lease is at most this old
NEIGHBOURS_LIVE_WARN_GAP=60    # at most one warning per this many seconds while reads fail
neigh_live_on=false            # for the on/off transition log only
neigh_live_warn_at=0           # epoch of the last live-read warning

# Signal history (NDJSON file for chart data)
SIGNAL_HISTORY_FILE="/tmp/qmanager_signal_history.json"
SIGNAL_HISTORY_MAX=180 # 30 min at 10s intervals

# PHY depth (Tier 3) — the last assembled snapshot, or empty until the first
# Tier-3 pass. write_cache publishes it as `phy` and OMITS the key while it is
# empty, so a boot before the first Tier-3 pass has today's cache shape exactly.
phy_json=""

# Ping history (NDJSON file for latency chart data)
PING_HISTORY_FILE="/tmp/qmanager_ping_history.json"
PING_HISTORY_MAX=8640  # ~38h at the measured ~16s row cadence (not 10s)

# --- Persistent Data Used counter (Tier 1) -----------------------------------
DATA_USED_FILE="/usrdata/qmanager/data_used.json"
DATA_USED_TMP="/usrdata/qmanager/data_used.json.tmp"
DATA_USED_RESET_FLAG="/tmp/qmanager_data_used_reset"
# data_used is sourced from the kernel rmnet interface byte counters
# (/proc/net/dev). The kernel labels rx/tx, but on some Quectel IPA driver
# builds (notably RM502Q-AE SDX55) the fast-path forwarding writes download
# bytes into the tx field and vice versa.
#
# Schema 5: counter orientation is determined once at startup from the
# SoC Branch Name in /etc/quectel-project-version (see
# detect_orientation_from_soc above). v3/v4 -> v5 upgrade resets
# accumulators to avoid mixing probe-era totals with the static-orientation
# regime.
DATA_USED_SCHEMA=5
# Kernel network-stats virtual file. Overridable for the test harness.
: "${DATA_USED_PROC_DEV:=/proc/net/dev}"

# --- State Variables ---------------------------------------------------------
cycle_count=0

# --- Modem crash watcher (sysfs subsys0/crash_count) -----------------------
_CRASH_COUNT_SYSFS="/sys/devices/platform/4080000.qcom,mss/subsys0/crash_count"
_CRASH_STATE_SYSFS="/sys/devices/platform/4080000.qcom,mss/subsys0/state"
_CRASH_SIDECAR="/etc/qmanager/.modem_crash_count_last"
_CRASH_LOG="/etc/qmanager/modem_crashes.json"
_crash_watcher_enabled=false   # set to true at startup if sysfs path exists
_last_crash_count=0            # last-known crash_count value

# --- Event Detection State ---------------------------------------------------
EVENTS_FILE="/tmp/qmanager_events.json"
PCI_STATE_FILE="/tmp/qmanager_pci_state.json"
# Ring depth. Five producers append to this one file (this poller,
# qmanager_watchcat, qmanager_profile_apply, profiles/deactivate.sh and
# profile_mgr.sh) and each trims it, so they must agree — change all five
# together. Raised from 50 because a single burst of radio churn could fill a
# 50-slot ring in 12 minutes and evict the outage the user was chasing.
# Measured cost on-device: ~117 bytes/event, so 300 slots is ~35KB against
# ~62MB free on /tmp. The browser is not made to pay for the extra depth —
# fetch_events.sh serves only the newest slice (see EVENTS_SERVE_LIMIT there).
MAX_EVENTS=300
events_initialized=false

# Previous state for change detection (prefixed prev_ev_ to avoid collision)
prev_ev_network_type=""
prev_ev_lte_band=""
prev_ev_lte_pci=""
prev_ev_nr_band=""
prev_ev_nr_pci=""
prev_ev_nr_state=""
prev_ev_modem_reachable=""
prev_ev_internet=""
prev_ev_ca_active=""
prev_ev_ca_count=""
prev_ev_nr_ca_active=""
prev_ev_nr_ca_count=""
prev_ev_service_status=""
prev_ev_carrier_components=""
prev_ev_cfun=""

# Data connection quality event debounce state
ev_high_lat_streak=0
ev_high_loss_streak=0
ev_lat_clear_streak=0
ev_loss_clear_streak=0
ev_lat_alerted=false
ev_loss_alerted=false

# Boot-only data (populated once)
boot_firmware=""
boot_build_date=""
boot_manufacturer=""
boot_model=""
boot_imei=""
boot_imsi=""
boot_iccid=""
boot_phone_number=""
boot_lte_category=""
boot_supported_lte_bands=""
boot_supported_nsa_nr5g_bands=""
boot_supported_sa_nr5g_bands=""
boot_ippt_mode="disabled"
boot_ippt_mac=""
boot_ippt_nat="1"
boot_ippt_usbnet="1"
boot_ippt_dhcpv4dns="disabled"
boot_lan_ip=""
boot_lan_gateway=""

# Tier 2 data (updated periodically)
t2_temperature=""
t2_carrier=""
t2_sim_status=""
t2_sim_inserted=""
t2_sim_slot="1"
t2_ca_active=false
t2_ca_count=0
t2_nr_ca_active=false
t2_nr_ca_count=0
t2_total_bandwidth_mhz=0
t2_bandwidth_details=""
t2_carrier_components="[]"
t2_apn=""
t2_primary_dns=""
t2_secondary_dns=""
t2_wan_ipv4=""
t2_wan_ipv6=""
t2_mimo=""
t1_cfun=1

# Tier 1 data (updated every cycle)
lte_state="unknown"
lte_band=""
lte_earfcn=""
lte_bandwidth=""
lte_pci=""
lte_rsrp=""
lte_rsrq=""
lte_sinr=""
lte_rssi=""
lte_cell_id=""
lte_enodeb_id=""
lte_sector_id=""
lte_tac=""

nr_state="unknown"
nr_band=""
nr_arfcn=""
nr_cell_id=""
nr_enodeb_id=""
nr_sector_id=""
nr_tac=""
nr_pci=""
nr_rsrp=""
nr_rsrq=""
nr_sinr=""
nr_scs=""

lte_ta=""
nr_ta=""

# Network state
network_type=""
service_status="unknown"
system_state="normal"
modem_reachable=true

# Error tracking
errors=""

# CPU tracking (from /proc/stat)
prev_cpu_idle=0
prev_cpu_total=0

# data_used in-memory mirror — initialized from file on first call.
# accumulated_rx is always the DOWNLOAD bucket and accumulated_tx the UPLOAD
# bucket; the SoC-based orientation map (see detect_orientation_from_soc)
# picks which raw /proc/net/dev field feeds each.
du_loaded=false
du_accumulated_rx=0
du_accumulated_tx=0
du_selected_counter=""
du_prev_ipa_rx=0
du_prev_ipa_tx=0
du_last_update_ts=0
du_last_reset_ts=0
du_modem_reset_count=0

# Counter orientation. Set once at startup by main() via
# detect_orientation_from_soc; persisted into data_used.json for
# diagnostics but always re-derived from the SoC each startup (the SoC
# does not change at runtime).
orientation="normal"                  # normal|reversed
orientation_dl_field=2                # /proc/net/dev field carrying download bytes
orientation_ul_field=10               # /proc/net/dev field carrying upload bytes

# Connectivity (from ping daemon)
conn_internet_available="null"
conn_status="unknown"
conn_latency="null"
conn_avg_latency="null"
conn_min_latency="null"
conn_max_latency="null"
conn_jitter="null"
conn_packet_loss="null"
conn_ping_target=""
conn_history="[]"
conn_history_interval=5
conn_history_size=60
conn_during_recovery="false"
# Phase 2 — runtime profile + last-probed address family (from ping daemon)
conn_profile="unknown"
conn_last_family="null"
_last_ping_ts=0          # tracks last processed ping.json timestamp (awk gate)
_ping_stale_since=0      # epoch when ping daemon first went stale (0 = healthy)

# History size constant (must match ping daemon)
CONN_HISTORY_SIZE=60

# Minimum samples before the RATIO statistics (packet loss, jitter) mean
# anything. Below this the poller emits a real JSON null for both.
#
# 10 is not arbitrary: the smallest loss threshold any consumer compares
# against is this file's own `>= 10` degraded gate (the UI presets are 15/30/
# 50). A window of n samples can only express loss in steps of 100/n percent,
# so n=10 is exactly the point at which a 10% reading becomes representable
# at all. At n=9 the quantum is 11.1% -- every window is either "0%" or an
# instant threshold breach, and the "0%" is the dangerous half: it is
# indistinguishable from a measured perfect link.
#
# This matters because qmanager_ping TRUNCATES /tmp/qmanager_ping_history on
# every probe-winner change, which on a lossy link happens repeatedly, so a
# 1-sample window is a recurring state and not a once-per-boot transient.
MIN_STAT_SAMPLES=10

# Connection uptime tracking
conn_uptime_seconds=0
conn_start_time=0

# System metrics
cpu_usage=0
memory_used_mb=0
memory_total_mb=0
uptime_seconds=0

# System health (modem subsystem + cpu/storage telemetry consumed by the
# System Health card and any other UI that wants near-realtime device stats).
# Populated by update_system_health(); read directly from sysfs/cpufreq/df.
sh_state="unknown"
sh_state_raw=""
sh_crash_count="null"
sh_coredump_present="false"
sh_last_crash_at="null"
sh_total_logged_crashes=0
sh_load_1m="null"
sh_load_5m="null"
sh_load_15m="null"
sh_core_count="null"
sh_freq_khz="null"
sh_max_freq_khz="null"
sh_storage_total_kb="null"
sh_storage_used_kb="null"
sh_storage_avail_kb="null"

# sysfs/sys paths (mirrored from modem-subsys.sh — single source of truth)
SH_SUBSYS_BASE="/sys/devices/platform/4080000.qcom,mss/subsys0"
SH_RAMDUMP_DIR="/sys/devices/platform/4080000.qcom,mss/ramdump/ramdump_modem"
SH_CRASH_LOG="/etc/qmanager/modem_crashes.json"
SH_CPUFREQ_BASE="/sys/devices/system/cpu/cpu0/cpufreq"

# Per-antenna signal data (Tier 1.5 — JSON array strings)
sig_lte_rsrp="[null,null,null,null]"
sig_lte_rsrq="[null,null,null,null]"
sig_lte_sinr="[null,null,null,null]"
sig_nr_rsrp="[null,null,null,null]"
sig_nr_rsrq="[null,null,null,null]"
sig_nr_sinr="[null,null,null,null]"

# =============================================================================
# LIBRARY LOADING
# =============================================================================

# Logging library
. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    # Fallback if logging library not found
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_at_cmd() { :; }
    qlog_lock() { :; }
    qlog_state_change() { :; }
}
qlog_init "poller"

# Backward-compatible aliases (used throughout this script)
log_info()  { qlog_info  "$1"; }
log_warn()  { qlog_warn  "$1"; }
log_error() { qlog_error "$1"; }

# Hardware identity — model / SoC parser, tier table, profile generator.
#
# NON-FATAL BY DESIGN, unlike parse_at.sh and events.sh below. Those exit 1 on
# a failed load; this one must not, and the reason is the unit file rather than
# the library. qmanager-poller.service is Restart=on-failure with
# StartLimitBurst=5 over StartLimitIntervalSec=3600, so a die-on-missing-library
# during a partial install, a mid-OTA window or a rollback would burn five
# restarts in about 25 seconds and then leave the poller STOPPED FOR AN HOUR —
# taking /tmp/qmanager_status.json and therefore the whole dashboard with it.
#
# Degrading is cheap here precisely because the built-in fallbacks
# (resolve_network_iface -> rmnet_ipa0, detect_orientation_from_soc -> normal)
# are byte-identical to the correct answers on every device measured to date.
# Losing the library costs nothing observable; dying on it costs everything.
#
# This must stay BELOW qlog_init and the log_* aliases above. Sourced any
# higher, the failure branch has no logging to report itself with, and a
# missing library would be genuinely silent: the unit sets no StandardOutput=
# and journald has no persistent storage on either target.
if [ -f /usr/lib/qmanager/hw_profile.sh ]; then
    . /usr/lib/qmanager/hw_profile.sh 2>/dev/null \
        || log_error "hw_profile.sh failed to load; identity reads use built-in defaults"
else
    log_error "hw_profile.sh not found; identity reads use built-in defaults"
fi

# AT command parsers
. /usr/lib/qmanager/parse_at.sh 2>/dev/null || {
    log_error "FATAL: Failed to load parse_at.sh"
    exit 1
}

# Event detection
. /usr/lib/qmanager/events.sh 2>/dev/null || {
    log_error "FATAL: Failed to load events.sh"
    exit 1
}

# Alert channel transports (optional — non-fatal if missing). The per-channel
# downtime timers were removed; these libs now expose only config parse +
# send/test/log helpers, driven by alert_engine.sh below.
. /usr/lib/qmanager/email_alerts.sh 2>/dev/null || {
    qlog_warn "email_alerts.sh not found, email alerts disabled"
}
. /usr/lib/qmanager/sms_alerts.sh 2>/dev/null || {
    qlog_warn "sms_alerts.sh not found, SMS alerts disabled"
}

# Unified alert engine — replaces the old per-channel check_email_alert /
# check_sms_alert timers with one monotonic downtime timer + routing x
# capability dispatch (see alert_engine.sh header). Optional — non-fatal
# if missing, matching the sibling libs above.
. /usr/lib/qmanager/alert_engine.sh 2>/dev/null || {
    qlog_warn "alert_engine.sh not found, alerts disabled"
    check_alerts() { :; }
    alert_engine_init() { :; }
}

# Shared ping.json reader + staleness rule. Fail-closed stub: no lib = always stale.
# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/conn_state.sh ]; then
    . /usr/lib/qmanager/conn_state.sh
else
    qlog_warn "conn_state.sh not found, connectivity reads as unknown"
    conn_state_read() { CQ_STALE=1; CQ_STALE_REASON="conn_state.sh missing"; return 1; }
    conn_state_why() { printf '%s' "$CQ_STALE_REASON"; }
    cq_thresholds_refresh() { :; }
    CQ_LAT_MS=250; CQ_LOSS_PCT=30
fi

# Profile manager (for boot-time profile auto-apply)
. /usr/lib/qmanager/profile_mgr.sh 2>/dev/null || {
    auto_apply_profile() { :; }
}

# Known-SIMs database (set-model SIM-swap detection + ICCID canonicalization).
# Self-guarded (_SIM_DB_LOADED) so re-sourcing elsewhere is a no-op.
. /usr/lib/qmanager/sim_db.sh 2>/dev/null || {
    qlog_warn "sim_db.sh not found, SIM-swap detection disabled"
    sim_db_seed_if_absent() { return 1; }
    sim_db_known() { return 1; }
    sim_db_add() { :; }
    sim_db_normalize() { printf '%s' "$1" | tr -d ' \r\n'; }
    iccid_canonicalize() { printf '%s' "$1" | tr -d ' \r\n'; }
}

# Persistent per-ICCID SIM registry (carrier/phone_number/first_seen/
# dismissed). Self-guarded (_SIM_REGISTRY_LOADED). Requires sim_db.sh (above)
# for sim_db_normalize.
. /usr/lib/qmanager/sim_registry.sh 2>/dev/null || {
    qlog_warn "sim_registry.sh not found, SIM registry writes disabled"
    sim_registry_seed_new() { :; }
    sim_registry_refresh_active() { :; }
    SIM_REGISTRY_FILE="/etc/qmanager/sim_registry.json"
}

# Read-only QMI reader (neighbour live view). NON-FATAL, like hw_profile.sh
# above: the lib is additive — losing it costs the live neighbour view, and a
# die-on-missing-library would cost the dashboard (see that block's comment for
# why the unit's restart budget makes this the expensive failure). The fallback
# reports "unavailable" for every function, which is exactly the degradation the
# spec requires: the live view says it is unavailable, the AT scanner keeps
# working.
. /usr/lib/qmanager/qmi_read.sh 2>/dev/null || {
    qlog_warn "qmi_read.sh not found, neighbour live view disabled"
    qm_qmi_available()    { return 1; }
    qm_qmi_neighbours()   { return 2; }
    qm_qmi_signal()       { return 2; }
    qm_qmi_registration() { return 2; }
    qm_qmi_band()         { return 2; }
}

# Read-only PHY reader (Tier 3). NON-FATAL for the same reason as the QMI lib
# above: losing it costs the PHY fields and the durable archive, and the cache
# then has no `phy` key at all — which is exactly the pre-feature shape, not a
# broken one. The fallbacks make every entry point fail closed, so Tier 3 simply
# never publishes and every other tier is untouched.
. /usr/lib/qmanager/phy_metrics.sh 2>/dev/null || {
    qlog_warn "phy_metrics.sh not found, Tier 3 (PHY depth) disabled"
    qm_phy_available()             { return 1; }
    qm_phy_modemd()                { return 2; }
    qm_phy_at()                    { return 3; }
    qm_phy_snapshot()              { return 4; }
    qm_phy_archive_row()           { return 3; }
}

# =============================================================================
# HELPER: SAFE QCMD CALL
# =============================================================================
# Calls qcmd and strips the echoed AT command + trailing OK from sms_tool output.
# Returns exit codes:
#   0 = success
#   1 = modem unreachable / timeout
#   2 = command returned ERROR (but modem is reachable)

qcmd_exec() {
    local cmd="$1"
    local result

    result=$(qcmd "$cmd" 2>/dev/null)
    local exit_code=$?

    if [ $exit_code -ne 0 ] || [ -z "$result" ]; then
        qlog_warn "qcmd_exec failed: cmd=${cmd} exit=${exit_code}"
        return 1
    fi

    # Strip echoed AT command and trailing OK from sms_tool output.
    #
    # ZERO FORKS. This used to be
    #   result=$(printf '%s\n' "$result" | grep -v '^AT' | grep -v '^OK$' | grep -v '^$')
    # which is one command substitution, three pipes and three greps. Measured
    # on hardware, each of those greps costs 3.55 ms of CPU on the RM520N-GL and
    # 4.75 ms on the RG501Q-EU, so ~11 ms and ~14 ms per call — and qcmd_exec
    # runs for EVERY AT command the poller issues, not just the serving cell.
    # The walk below is the same pure-bash suffix-trim idiom parse_serving_cell
    # and read_ping_data already use, and it creates no processes at all.
    # scripts/test/poller-defork-forkcount.sh pins the ceiling at 1 (the qcmd
    # substitution above, which is the AT transport itself).
    #
    # The three filters are reproduced EXACTLY, carriage returns and all:
    #   AT*  drops any line STARTING WITH AT   (grep -v '^AT')
    #   OK   drops a line that is EXACTLY OK   (grep -v '^OK$')
    #   ""   drops an EMPTY line               (grep -v '^$')
    # AT responses are CRLF-terminated, so a line of "OK<CR>" and a line that is
    # only "<CR>" both SURVIVE here — exactly as they survived the greps, which
    # anchored on end-of-line. Do NOT "fix" that by trimming the CR: callers
    # already parse the output as it is, and this change is a pure refactor.
    #
    # $_qe_nl holds a literal newline. It is left UNQUOTED in the patterns below
    # on purpose: a newline is not a glob metacharacter, so quoting would change
    # nothing about the match, and the unquoted form avoids nesting quotes inside
    # a ${...} word — the one construct here whose bash 3.2 behaviour (the
    # RM520N-GL ships bash 3.2.57) is worth not betting on.
    local _qe_nl=$'\n'
    local _qe_rest="$result"
    local _qe_line
    local _qe_out=""
    while [ -n "$_qe_rest" ]; do
        _qe_line="${_qe_rest%%$_qe_nl*}"
        case "$_qe_rest" in
            *$_qe_nl*) _qe_rest="${_qe_rest#*$_qe_nl}" ;;
            *)         _qe_rest="" ;;
        esac
        case "$_qe_line" in
            AT*) continue ;;
            OK)  continue ;;
            "")  continue ;;
        esac
        if [ -n "$_qe_out" ]; then
            _qe_out="$_qe_out$_qe_nl$_qe_line"
        else
            _qe_out="$_qe_line"
        fi
    done
    result="$_qe_out"

    case "$result" in
        *ERROR*)
            qlog_debug "qcmd_exec AT ERROR: cmd=${cmd}"
            echo "$result"
            return 2
            ;;
    esac

    echo "$result"
    return 0
}

# =============================================================================
# Extended CA / MIMO / timing reporting — ON ONLY FOR THE READ (v0.1.34 hotfix)
# =============================================================================
# Upstream v0.1.34 release note (dr-dolomite/QManager), verbatim:
#
#   "QManager left the modem's extended carrier-aggregation reporting switched
#    on all the time, which made R01A04 drop the connection again and again. It
#    is now switched on only for the moment each reading is taken, so 5G carrier
#    details still show in full."
#
# This poller had the same defect: collect_boot_data() sent the ",1" enables once
# at boot and NOTHING ever cleared them, so extended reporting stayed latched on
# for the life of the modem session. Both read sites are now wrapped:
#
#     ca_ext_on ; <read> ; ca_ext_off
#
# The off half runs even when the read fails or returns nothing, so a transient
# AT error cannot leave reporting latched on — which is the whole point of the
# upstream fix. Do NOT re-introduce a permanent enable.
#
# Verified on the RG520N-EB (2026-10-22): AT+QCAINFO=0 -> OK,
# +QNWCFG="*_mimo_layers",0 -> OK, and a subsequent AT+QCAINFO still returns the
# full PCC/SCC carrier list, so 5G details are not lost.
# Built PER NETWORK MODE, not as one compound. `qcmd` fails the ENTIRE response if
# the word ERROR appears anywhere in it, so a command the current mode rejects
# poisons every other field in the same compound — observed in the field log as
#   ERROR qcmd: Command returned ERROR: AT+QCAINFO=1;+QNWCFG="lte_mimo_layers",1;...
# after which every read returned nothing and .phy.* stayed null. Same lesson the
# B1/B2/B3/B4 split in collect_boot_data() already records: fewer eggs per basket.
#
# Mode rules (the read side already follows them; the enables must match):
#   lte_mimo_layers, lte_time_advance   LTE and 5G-NSA   (error in SA)
#   nr5g_mimo_layers                    5G-SA only       (error in LTE/NSA)
#   nr5g_time_advance                   5G-NSA AND 5G-SA
#
# ⚠️ nr5g_time_advance is NOT SA-only. An earlier revision of this helper sent
# the whole NR group only in SA, so in NSA the NR TA was never enabled and
# phy.nr.time_advance read null — which blanked NR Cell Distance on the dashboard
# (the one distance AGENTS.md says IS trustworthy here). Measured 2026-10-22 on
# the RG520N-EB in 5G-NSA: enable -> OK, read -> "nr5g_time_advance",1,25600,25600,
# and the NSA compound below returns OK with no ERROR.
#
# QCAINFO is NOT in these groups: it has its own hot-path helper below.
ca_ext_cmd() {   # $1 = 1 (enable) or 0 (disable); prints the compound for this mode
    case "$network_type" in
        5G-SA)  printf 'AT+QNWCFG="nr5g_mimo_layers",%s;+QNWCFG="nr5g_time_advance",%s' "$1" "$1" ;;
        5G-NSA) printf 'AT+QNWCFG="lte_mimo_layers",%s;+QNWCFG="lte_time_advance",%s;+QNWCFG="nr5g_time_advance",%s' "$1" "$1" "$1" ;;
        LTE)    printf 'AT+QNWCFG="lte_mimo_layers",%s;+QNWCFG="lte_time_advance",%s' "$1" "$1" ;;
        *)      : ;;   # mode unknown: send nothing rather than guess
    esac
}

# QCAINFO is read every poll cycle (hot path). Upstream v0.1.34 specifically
# requires extended CA reporting to be on only for the read. Keep this separate
# from the MIMO/TA tier-3 group so the 2s path toggles only the CA reporter.
CA_INFO_ON='AT+QCAINFO=1'
CA_INFO_OFF='AT+QCAINFO=0'
# ONE round-trip: on, read, off as a single compound. It used to be three qcmd
# calls, the most expensive line in the poller: 282 ms of CPU and ~2 s of AT-lock
# hold per cycle on the RG520N-EB (measured 2026-10-22, poller-cpu-profile.md
# "O5A profile"). Measured the same day: the compound returns exactly the
# read's lines (the =1/=0 legs add only the final OK), including the NR SCC's
# RSRP/RSRQ/SNR that only appear while =1 is set.
# The "off only for the read" contract survives a failure: a modem aborts a
# compound at the first ERROR, so if anything failed the =0 leg may not have
# run, and it is re-sent on its own. Success means every leg ran, =0 included.
CA_INFO_READ_ONCE='AT+QCAINFO=1;+QCAINFO;+QCAINFO=0'
ca_info_read() {
    local _out _rc
    _out=$(qcmd_exec "$CA_INFO_READ_ONCE")
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        qcmd "$CA_INFO_OFF" >/dev/null 2>&1
    fi
    [ "$_rc" -eq 0 ] && printf '%s' "$_out"
    return "$_rc"
}

# Enable/disable the mode's MIMO + timing-advance reporters. No-op when the mode
# is unknown (ca_ext_cmd prints nothing).
ca_ext_on() {
    local _c; _c=$(ca_ext_cmd 1)
    [ -n "$_c" ] && qcmd "$_c" >/dev/null 2>&1
    return 0
}
ca_ext_off() {
    local _c; _c=$(ca_ext_cmd 0)
    [ -n "$_c" ] && qcmd "$_c" >/dev/null 2>&1
    return 0
}
# Run one AT read with extended reporting switched on only for that read.
# Prints the read's output; the disable cannot be skipped by an early return in
# the caller because it happens here.
ca_ext_read() {
    local _out
    ca_ext_on
    _out=$(qcmd "$1" 2>/dev/null)
    ca_ext_off
    printf '%s' "$_out"
}

# =============================================================================
# SYSTEM METRICS (No modem lock needed)
# =============================================================================

# ZERO FORKS BY CONTRACT. Every value below comes out of a /proc file that the
# read builtin can open directly, so this function creates no processes at all.
# It used to cost 22 of them (66 ms/cycle on the RM520N-GL, 86 ms on the
# RG501Q-EU) purely in fork+exec overhead — see docs/reference/poller-cpu-profile.md.
# scripts/test/poller-defork-forkcount.sh pins the ceiling at 0; adding a command
# substitution, a pipe or an applet call here turns it red.
update_proc_metrics() {
    # --- CPU Usage % (from /proc/stat delta) ---
    # /proc/stat line 1: cpu user nice system idle iowait irq softirq steal ...
    local _pm_cpu _pm_user _pm_nice _pm_sys _pm_idle
    local _pm_iowait _pm_irq _pm_softirq _pm_steal _pm_tail
    _pm_cpu=""
    read -r _pm_cpu _pm_user _pm_nice _pm_sys _pm_idle \
            _pm_iowait _pm_irq _pm_softirq _pm_steal _pm_tail < /proc/stat 2>/dev/null
    if [ -n "$_pm_cpu" ]; then
        local cur_idle
        local cur_total
        cur_idle=$_pm_idle
        cur_total=$(( _pm_user + _pm_nice + _pm_sys + _pm_idle \
                    + _pm_iowait + _pm_irq + _pm_softirq + _pm_steal ))

        if [ "$prev_cpu_total" -gt 0 ] 2>/dev/null; then
            local diff_idle
            local diff_total
            diff_idle=$((cur_idle - prev_cpu_idle))
            diff_total=$((cur_total - prev_cpu_total))

            if [ "$diff_total" -gt 0 ] 2>/dev/null; then
                # Integer math: (diff_total - diff_idle) * 100 / diff_total
                cpu_usage=$(( (diff_total - diff_idle) * 100 / diff_total ))
            fi
        fi

        prev_cpu_idle=$cur_idle
        prev_cpu_total=$cur_total
    fi

    # --- Memory ---
    # One pass over /proc/meminfo with the read builtin. MemTotal: and
    # MemAvailable: are lines 1 and 3 on both devices, so the break lands almost
    # immediately; a host without MemAvailable (MSYS2's emulated /proc) simply
    # scans to EOF and leaves mem_available empty, which is the same outcome the
    # old grep produced.
    local mem_total
    local mem_available
    local _pm_key _pm_val
    mem_total=""
    mem_available=""
    while read -r _pm_key _pm_val _pm_tail; do
        case "$_pm_key" in
            MemTotal:)     mem_total="$_pm_val" ;;
            MemAvailable:) mem_available="$_pm_val" ;;
            *)             continue ;;
        esac
        [ -n "$mem_total" ] && [ -n "$mem_available" ] && break
    done < /proc/meminfo 2>/dev/null

    if [ -n "$mem_total" ]; then
        memory_total_mb=$((mem_total / 1024))
    else
        memory_total_mb=0
    fi

    if [ -n "$mem_available" ] && [ -n "$mem_total" ]; then
        memory_used_mb=$(( (mem_total - mem_available) / 1024 ))
    else
        memory_used_mb=0
    fi

    # --- Uptime ---
    # /proc/uptime is "<seconds>.<hundredths> <idle>"; read takes the first word
    # and %%.* drops the fraction, replacing cat | cut | cut.
    local _pm_up
    _pm_up=""
    read -r _pm_up _pm_tail < /proc/uptime 2>/dev/null
    uptime_seconds="${_pm_up%%.*}"
    uptime_seconds="${uptime_seconds:-0}"

    cpu_usage="${cpu_usage:-0}"
}

# --- System Health -----------------------------------------------------------
# Collects modem-subsystem state (sysfs) plus CPU/storage telemetry that the
# System Health card consumes. Output flows into the top-level system_health
# block of /tmp/qmanager_status.json so the CGI is a thin cache reader.
#
# Cheap reads only — no AT commands. EXACTLY TWO external calls survive, and
# both are deliberate: `df` is the only source of the /usrdata figures, and `jq`
# is the schema boundary on the crash log. Everything else is a builtin, because
# this function ran every cycle and spent 78 ms (RM520N-GL) / 105 ms (RG501Q-EU)
# per cycle on 37 fork+exec sites that computed almost nothing —
# see docs/reference/poller-cpu-profile.md. scripts/test/poller-defork-forkcount.sh
# pins the ceiling at 4 (each surviving substitution scores one cmd-sub plus one
# applet). Do not add a third.
update_system_health() {
    # --- subsys state + state_raw -------------------------------------------
    sh_state_raw=""
    if [ -r "${SH_SUBSYS_BASE}/state" ]; then
        read -r sh_state_raw < "${SH_SUBSYS_BASE}/state" 2>/dev/null
    fi
    if [ -z "$sh_state_raw" ]; then
        sh_state="unknown"
    else
        # Bracket globs do the case folding the old `tr '[:upper:]' '[:lower:]'`
        # did, with no fork. bash 3.2 (the RM520N-GL's shell) has no ${var,,}.
        # The devices answer ONLINE in uppercase.
        case "$sh_state_raw" in
            [Oo][Nn][Ll][Ii][Nn][Ee])          sh_state="online"  ;;
            [Oo][Ff][Ff][Ll][Ii][Nn][Ee])      sh_state="offline" ;;
            [Cc][Rr][Aa][Ss][Hh][Ee][Dd])      sh_state="crashed" ;;
            *)                                 sh_state="unknown" ;;
        esac
    fi

    # --- crash_count (sysfs counter) ----------------------------------------
    sh_crash_count="null"
    if [ -r "${SH_SUBSYS_BASE}/crash_count" ]; then
        local _cc
        _cc=""
        read -r _cc < "${SH_SUBSYS_BASE}/crash_count" 2>/dev/null
        case "$_cc" in
            *[!0-9]*) sh_crash_count="null" ;;
            "")       sh_crash_count="null" ;;
            *)        sh_crash_count="$_cc" ;;
        esac
    fi

    # --- coredump_present ---------------------------------------------------
    # Match modem-subsys.sh CGI: exclude sysfs metadata pseudo-files.
    # A glob loop replaces `find -maxdepth 1 -type f -size +0 ... | head -1`:
    # -type f -size +0 becomes -f plus -s, the ! -name list becomes a case, and
    # `head -1` becomes break. An unmatched glob stays literal, so the -f test
    # rejects it.
    sh_coredump_present="false"
    if [ -d "$SH_RAMDUMP_DIR" ]; then
        local _dump
        for _dump in "$SH_RAMDUMP_DIR"/*; do
            [ -f "$_dump" ] || continue
            [ -s "$_dump" ] || continue
            # One pattern per branch rather than a "dev|name|..." alternation:
            # the fork-site scanner in scripts/test/poller-defork-forkcount.sh is
            # lexical and reads a "|" in a case pattern as a pipeline. Same six
            # exclusions the old find carried, same behaviour.
            case "${_dump##*/}" in
                dev)                  continue ;;
                name)                 continue ;;
                power)                continue ;;
                subsystem)            continue ;;
                uevent)               continue ;;
                waiting_for_supplier) continue ;;
            esac
            sh_coredump_present="true"
            break
        done
    fi

    # --- crash log summary (last_crash_at + total_logged_crashes) ------------
    # The log is the 3-byte literal "[]" on both devices in the normal case, so
    # the first line is read with a builtin and the jq is skipped entirely. When
    # there ARE crashes, ONE jq emits both values on one line; the old code paid
    # for two (jq costs 11.10 ms on the RM520N-GL, 4.3x a normal applet).
    # `last.ts|tojson` reproduces the old non-raw `jq 'last.ts'` output byte for
    # byte, quotes included — sh_last_crash_at is embedded raw into the cache
    # JSON, so it must stay JSON-encoded.
    sh_last_crash_at="null"
    sh_total_logged_crashes=0
    if [ -f "$SH_CRASH_LOG" ] && [ -s "$SH_CRASH_LOG" ]; then
        local _cl_first _cl_out
        _cl_first=""
        read -r _cl_first < "$SH_CRASH_LOG" 2>/dev/null
        if [ "$_cl_first" != "[]" ]; then
            _cl_out=$(jq -r '[(length|tostring),
                              (if length > 0
                                 then (try (last.ts|tojson) catch "null")
                                 else "null" end)]
                             | join("|")' "$SH_CRASH_LOG" 2>/dev/null) || _cl_out=""
            if [ -n "$_cl_out" ]; then
                sh_total_logged_crashes="${_cl_out%%|*}"
                sh_last_crash_at="${_cl_out#*|}"
            fi
        fi
    fi

    # --- load averages (1m / 5m / 15m) --------------------------------------
    sh_load_1m="null"
    sh_load_5m="null"
    sh_load_15m="null"
    if [ -r /proc/loadavg ]; then
        read sh_load_1m sh_load_5m sh_load_15m _rest < /proc/loadavg
    fi

    # --- core_count (cache after first read — value never changes at runtime)
    # Counting /proc/cpuinfo's "processor" lines with a read loop gives the same
    # answer as nproc on both devices (cpuinfo lists online CPUs only) for zero
    # forks, so the nproc/grep -c pair is gone.
    if [ "$sh_core_count" = "null" ]; then
        local _cpu_key _cpu_rest _cpu_n
        _cpu_n=0
        while read -r _cpu_key _cpu_rest; do
            [ "$_cpu_key" = "processor" ] && _cpu_n=$((_cpu_n + 1))
        done < /proc/cpuinfo 2>/dev/null
        [ "$_cpu_n" -gt 0 ] && sh_core_count="$_cpu_n"
    fi

    # --- cpu frequency (current + max from cpufreq) -------------------------
    sh_freq_khz="null"
    if [ -r "${SH_CPUFREQ_BASE}/scaling_cur_freq" ]; then
        read -r sh_freq_khz < "${SH_CPUFREQ_BASE}/scaling_cur_freq" 2>/dev/null
    fi
    sh_max_freq_khz="null"
    if [ -r "${SH_CPUFREQ_BASE}/scaling_max_freq" ]; then
        read -r sh_max_freq_khz < "${SH_CPUFREQ_BASE}/scaling_max_freq" 2>/dev/null
    fi

    # --- storage (/usrdata partition) ---------------------------------------
    sh_storage_total_kb="null"
    sh_storage_used_kb="null"
    sh_storage_avail_kb="null"
    # NOTE: `df -P /usrdata` resolves to a tmpfs mount on BOTH devices, so these
    # figures describe tmpfs and not the /usrdata volume. That is a pre-existing
    # defect tracked separately and deliberately NOT fixed here — the de-fork
    # pass must not change a single emitted value.
    #
    # The df substitution stays (it is the only source of these numbers), but its
    # four awk calls do not: line 2 is taken with parameter expansion and split
    # with `set --`, whose positional parameters are function-local.
    local _df_out _df_line _df_rest
    local _df_nl='
'
    _df_out=$(df -P /usrdata 2>/dev/null)
    if [ $? -eq 0 ] && [ -n "$_df_out" ]; then
        _df_line=""
        _df_rest="${_df_out#*$_df_nl}"
        [ "$_df_rest" != "$_df_out" ] && _df_line="${_df_rest%%$_df_nl*}"
        if [ -n "$_df_line" ]; then
            # Unquoted `set --` does word splitting AND pathname expansion, but
            # the awk it replaces only ever split. A df line carrying a glob
            # metacharacter would therefore shift $2/$3/$4 in the new code and
            # not the old, so globbing is disabled across the split to keep the
            # port faithful. Restore only if it was not already set.
            local _df_noglob=0
            case $- in *f*) _df_noglob=1 ;; esac
            set -f
            set -- $_df_line
            [ "$_df_noglob" -eq 0 ] && set +f
            sh_storage_total_kb="${2:-}"
            sh_storage_used_kb="${3:-}"
            sh_storage_avail_kb="${4:-}"
            [ -z "$sh_storage_total_kb" ] && sh_storage_total_kb="null"
            [ -z "$sh_storage_used_kb"  ] && sh_storage_used_kb="null"
            [ -z "$sh_storage_avail_kb" ] && sh_storage_avail_kb="null"
        fi
    fi
}

# --- Connection Uptime -------------------------------------------------------
# Tracks how long the modem has had internet connectivity (based on ping daemon).
# Starts counting when conn_internet_available becomes "true", resets on "false".
# Holds steady (no reset) when ping data is unavailable ("null") — avoids
# resetting the timer just because the ping daemon hasn't started yet.
update_conn_uptime() {
    if [ "$conn_internet_available" = "true" ]; then
        # Internet is reachable — start or continue counting
        if [ "$conn_start_time" -eq 0 ] 2>/dev/null; then
            conn_start_time=$(date +%s)
            qlog_debug "Connection uptime timer started"
        fi
        local now
        now=$(date +%s)
        conn_uptime_seconds=$((now - conn_start_time))
    elif [ "$conn_internet_available" = "false" ]; then
        # Internet confirmed down — reset timer
        if [ "$conn_start_time" -gt 0 ] 2>/dev/null; then
            qlog_info "Connection uptime timer reset (internet lost after ${conn_uptime_seconds}s)"
        fi
        conn_start_time=0
        conn_uptime_seconds=0
    fi
    # If conn_internet_available is "null" (ping daemon not running / stale),
    # leave timer as-is — don't reset, don't count up.
}


# =============================================================================
# PERSISTENT DATA USED COUNTER (Tier 1)
# =============================================================================
# Tracks cumulative rx/tx bytes across modem reboots using the kernel
# rmnet interface counters from /proc/net/dev. State persists atomically
# to DATA_USED_FILE each tick.

# The per-tick write is RATE-LIMITED (see update_data_used Step 6); every other
# caller (reset, migration, first baseline, counter rebase) writes immediately.
# 30 s keeps qmanager_health_check's "data_used.json fresh (mtime < 60s)" green.
DATA_USED_PERSIST_SEC=30
_du_written_up=-1
write_data_used_state() {
    [ -d /usrdata/qmanager ] || mkdir -p /usrdata/qmanager 2>/dev/null
    local _up _upr
    read -r _up _upr < /proc/uptime 2>/dev/null
    _du_written_up=${_up%%.*}
    jq -n \
        --argjson schema    "$DATA_USED_SCHEMA" \
        --argjson acc_rx    "$du_accumulated_rx" \
        --argjson acc_tx    "$du_accumulated_tx" \
        --arg     sel       "$du_selected_counter" \
        --arg     orient    "$orientation" \
        --argjson prev_i_rx "$du_prev_ipa_rx" \
        --argjson prev_i_tx "$du_prev_ipa_tx" \
        --argjson last_upd  "$du_last_update_ts" \
        --argjson last_rst  "$du_last_reset_ts" \
        --argjson modem_rst "$du_modem_reset_count" \
        '{
            schema:               $schema,
            accumulated_rx_bytes: $acc_rx,
            accumulated_tx_bytes: $acc_tx,
            selected_counter:     $sel,
            orientation:          $orient,
            prev_ipa_rx:          $prev_i_rx,
            prev_ipa_tx:          $prev_i_tx,
            last_update_ts:       $last_upd,
            last_reset_ts:        $last_rst,
            modem_reset_count:    $modem_rst
        }' > "$DATA_USED_TMP" && mv "$DATA_USED_TMP" "$DATA_USED_FILE"
}

update_data_used() {
    # Step 0: lazy-load persisted state on the first call.
    if [ "$du_loaded" = "false" ]; then
        if [ -f "$DATA_USED_FILE" ]; then
            # Schema policy (v5):
            #   < v3  -> discard (pre-Schema-3 state is incompatible)
            #   v3/v4 -> RESET accumulators on upgrade; historic totals
            #            may have been recorded against a probe misverdict
            #            and must not be carried into the static regime
            #   = v5  -> load directly
            local _on_disk_schema
            _on_disk_schema=$(jq -r '.schema // 0' "$DATA_USED_FILE" 2>/dev/null)
            if [ "${_on_disk_schema:-0}" -lt 3 ]; then
                qlog_info "data_used: schema v${_on_disk_schema:-0} too old; resetting state"
                rm -f "$DATA_USED_FILE"
            elif [ "${_on_disk_schema:-0}" -lt 5 ]; then
                qlog_info "data_used: schema v${_on_disk_schema:-0} -> v5 migration; counters reset (orientation now static)"
                du_accumulated_rx=0
                du_accumulated_tx=0
                du_prev_ipa_rx=0
                du_prev_ipa_tx=0
                du_last_update_ts=0
                du_last_reset_ts=$(date +%s)
                du_modem_reset_count=0
                write_data_used_state
            else
                local _jv
                _jv=$(jq -r '
                    (.accumulated_rx_bytes // 0 | tostring) + " " +
                    (.accumulated_tx_bytes // 0 | tostring) + " " +
                    (.prev_ipa_rx          // 0 | tostring) + " " +
                    (.prev_ipa_tx          // 0 | tostring) + " " +
                    (.last_update_ts       // 0 | tostring) + " " +
                    (.last_reset_ts        // 0 | tostring) + " " +
                    (.modem_reset_count    // 0 | tostring)
                ' "$DATA_USED_FILE" 2>/dev/null)
                if [ -n "$_jv" ]; then
                    du_accumulated_rx=$(   printf '%s' "$_jv" | awk '{print $1}')
                    du_accumulated_tx=$(   printf '%s' "$_jv" | awk '{print $2}')
                    du_prev_ipa_rx=$(      printf '%s' "$_jv" | awk '{print $3}')
                    du_prev_ipa_tx=$(      printf '%s' "$_jv" | awk '{print $4}')
                    du_last_update_ts=$(   printf '%s' "$_jv" | awk '{print $5}')
                    du_last_reset_ts=$(    printf '%s' "$_jv" | awk '{print $6}')
                    du_modem_reset_count=$(printf '%s' "$_jv" | awk '{print $7}')
                fi
            fi
        fi
        if [ ! -f "$DATA_USED_FILE" ]; then
            mkdir -p /usrdata/qmanager 2>/dev/null
        fi
        du_loaded=true
    fi

    # Step 1: honor the user reset flag — zero the accumulators but keep
    # the kernel baseline so the next tick accrues only post-reset bytes.
    if [ -f "$DATA_USED_RESET_FLAG" ]; then
        du_accumulated_rx=0
        du_accumulated_tx=0
        du_last_reset_ts=$(date +%s)
        du_modem_reset_count=0
        rm -f "$DATA_USED_RESET_FLAG"
        qlog_info "data_used: user reset triggered (counters zeroed)"
        # Persist the zeroed state now so an early return (e.g. interface
        # absent) or a crash before Step 6 cannot resurrect the old counters.
        write_data_used_state
    fi

    # Step 2: read the kernel cellular-interface byte counters.
    # /proc/net/dev is a kernel virtual file: after the "iface:" token,
    # field 2 holds one direction's byte total and field 10 the other.
    # main() resolves orientation from the SoC at startup via
    # detect_orientation_from_soc and sets $orientation_dl_field /
    # $orientation_ul_field. Defaults (2/10) match Quectel spec and are what
    # EVERY SoC resolves to today — the SDX55 arm is inert, and the claim that
    # SDX55 firmwares flip the fields is unsettled, not established. See the
    # note on detect_orientation_from_soc above.
    # ipa_rx is always the DOWNLOAD bytes; ipa_tx is always the UPLOAD bytes.
    #
    # ZERO FORKS (was grep + two awk per cycle). Same semantics: every line
    # containing "<iface>:" is considered, and fields are whitespace-split as
    # awk does. Two matching lines join with a newline, exactly as the grep|awk
    # pair produced, so the numeric guard below still rejects that tick.
    local _dev_line="" _dl ipa_rx="" ipa_tx="" _nl='
'
    while IFS= read -r _dl; do
        case "$_dl" in
            *"${NETWORK_IFACE}:"*)
                set -f
                # shellcheck disable=SC2086 # intentional whitespace split
                set -- $_dl
                set +f
                eval "_dl_rx=\${$orientation_dl_field:-}; _dl_tx=\${$orientation_ul_field:-}"
                if [ -n "$_dev_line" ]; then
                    ipa_rx="$ipa_rx$_nl$_dl_rx"; ipa_tx="$ipa_tx$_nl$_dl_tx"
                else
                    ipa_rx="$_dl_rx"; ipa_tx="$_dl_tx"
                fi
                _dev_line="$_dl"
                ;;
        esac
    done 2>/dev/null < "$DATA_USED_PROC_DEV"
    if [ -z "$_dev_line" ]; then
        qlog_warn "data_used: ${NETWORK_IFACE} not found in ${DATA_USED_PROC_DEV}; skipping tick"
        return 0
    fi

    # Numeric guard — a malformed line must not poison the accumulator.
    case "$ipa_rx" in ''|*[!0-9]*)
        qlog_warn "data_used: non-numeric rx '${ipa_rx}'; skipping tick"; return 0 ;;
    esac
    case "$ipa_tx" in ''|*[!0-9]*)
        qlog_warn "data_used: non-numeric tx '${ipa_tx}'; skipping tick"; return 0 ;;
    esac

    # Step 3: first-time baseline — cannot accumulate without a prev sample.
    if [ "$du_prev_ipa_rx" = "0" ] && [ "$du_prev_ipa_tx" = "0" ]; then
        du_prev_ipa_rx="$ipa_rx"
        du_prev_ipa_tx="$ipa_tx"
        du_selected_counter="$NETWORK_IFACE"
        du_last_update_ts=$(date +%s)
        write_data_used_state
        return 0
    fi

    # Step 4: delta vs the previous tick.
    local delta_rx delta_tx
    delta_rx=$((ipa_rx - du_prev_ipa_rx))
    delta_tx=$((ipa_tx - du_prev_ipa_tx))

    # Step 5: counter-reset detection. The kernel rmnet counter zeroes on
    # a modem reboot or interface re-creation, so a negative delta means
    # the baseline is stale. Rebase without accumulating — the bytes moved
    # while the modem was rebooting are not measurable.
    local _du_force=false
    if [ "$delta_rx" -lt 0 ] || [ "$delta_tx" -lt 0 ]; then
        qlog_info "data_used: ${NETWORK_IFACE} counter reset detected (delta_rx=${delta_rx} delta_tx=${delta_tx}); rebasing"
        du_modem_reset_count=$((du_modem_reset_count + 1))
        _du_force=true
    else
        du_accumulated_rx=$((du_accumulated_rx + delta_rx))
        du_accumulated_tx=$((du_accumulated_tx + delta_tx))
    fi

    # Step 6: persist for the next tick.
    du_prev_ipa_rx="$ipa_rx"
    du_prev_ipa_tx="$ipa_tx"
    du_selected_counter="$NETWORK_IFACE"
    du_last_update_ts=$(date +%s)
    # Persist at most every DATA_USED_PERSIST_SEC (a jq + mv to FLASH every
    # ~6 s cycle before — ~14k ubifs rewrites a day). A poller restart loses
    # nothing: the file keeps the kernel baseline (prev_ipa_*) it was written
    # with, so the next delta is taken against it and still counts every byte
    # since. The one window that widens: if the KERNEL counter also resets
    # (modem reboot) before the next write, up to 30 s of traffic is dropped
    # by the rebase, where it used to be up to one cycle. The in-memory totals
    # feed /tmp/qmanager_status.json every cycle as before.
    local _up _upr
    read -r _up _upr < /proc/uptime 2>/dev/null
    _up=${_up%%.*}
    if [ "$_du_force" = "true" ] || [ "$_du_written_up" -lt 0 ] || \
       [ $(( _up - _du_written_up )) -ge "$DATA_USED_PERSIST_SEC" ] || \
       [ $(( _up - _du_written_up )) -lt 0 ]; then
        write_data_used_state
    fi
}

# =============================================================================
# BOOT DATA COLLECTION (runs once at startup)
# =============================================================================

# -----------------------------------------------------------------------------
# resolve_kernel_addressing — fill WAN/LAN addresses from the kernel.
#
# Upstream reads these over AT: AT+QMAP="WWAN" for the WAN IPv4/IPv6, and
# AT+QMAP="LANIP" for the LAN gateway. The RG520N-EB answers a bare ERROR to
# every QMAP form, so the UI's Addressing group and the About page showed blank
# IPs and a blank LAN gateway on a device that was fully online.
#
# The kernel holds the same facts and cannot fail this way: the default route
# names the WAN interface, and the LAN gateway is the bridge's own address.
# Blanks ONLY are filled, so an AT-derived value still wins if a future firmware
# supports QMAP.
# -----------------------------------------------------------------------------
resolve_kernel_addressing() {
    local ipcmd=/sbin/ip
    [ -x "$ipcmd" ] || ipcmd=ip

    if [ -z "$t2_wan_ipv4" ] || [ -z "$t2_wan_ipv6" ]; then
        local wan v4 v6
        wan=$($ipcmd route show default 2>/dev/null | awk '
            /^default/ { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i+1); exit } }')
        [ -n "$wan" ] || wan=$(resolve_network_iface)

        if [ -n "$wan" ]; then
            if [ -z "$t2_wan_ipv4" ]; then
                v4=$($ipcmd -4 -o addr show dev "$wan" 2>/dev/null | awk '
                    { for (i = 1; i <= NF; i++) if ($i == "inet") { print $(i+1); exit } }')
                t2_wan_ipv4=${v4%%/*}
            fi
            if [ -z "$t2_wan_ipv6" ]; then
                # scope global skips the fe80:: link-local every iface carries.
                v6=$($ipcmd -6 -o addr show dev "$wan" scope global 2>/dev/null | awk '
                    { for (i = 1; i <= NF; i++) if ($i == "inet6") { print $(i+1); exit } }')
                t2_wan_ipv6=${v6%%/*}
            fi
        fi
    fi

    if [ -z "$boot_lan_ip" ]; then
        local br lan
        for br in bridge0 br-lan br0; do
            lan=$($ipcmd -4 -o addr show dev "$br" 2>/dev/null | awk '
                { for (i = 1; i <= NF; i++) if ($i == "inet") { print $(i+1); exit } }')
            [ -n "$lan" ] || continue
            boot_lan_ip=${lan%%/*}
            boot_lan_gateway="$boot_lan_ip"
            break
        done
    fi
}

# Boot-phase stopwatch: _bt_mark <name> appends "name=<s.cs>" (time since the
# previous mark) to _BT. Builtin /proc/uptime reads only. The one summary line it
# feeds is how boot time is measured on a real reboot (AGENTS.md hard rule 6 —
# only a reboot proves boot behaviour); see docs/reference/boot-timeline.md.
_bt_cs() { local _u _r; read -r _u _r < /proc/uptime; _BT_NOW=$(( ${_u%%.*} * 100 + 10#${_u#*.} )); }
_bt_mark() {
    local _d _f
    _bt_cs
    _d=$(( _BT_NOW - _BT_LAST )); _BT_LAST=$_BT_NOW
    printf -v _f '%d.%02d' $(( _d / 100 )) $(( _d % 100 ))
    _BT="$_BT $1=$_f"
}

collect_boot_data() {
    log_info "Collecting boot-only data..."
    _bt_cs; _BT_LAST=$_BT_NOW; _BT_START=$_BT_NOW; _BT=""

    local result

    # =========================================================================
    # Group A: Identity reads — compound AT (6 calls -> one lock acquisition).
    # CVERSION, CGMM, CGSN, CIMI return bare responses (no +PREFIX:).
    # CGMM: bare model name; CGSN/CIMI: bare 15-digit numbers.
    # Order is deterministic: first 15-digit line = IMEI, second = IMSI.
    # QGETCAPABILITY is intentionally separate: it is optional and a failure
    # in that final query used to make qcmd discard every identity response.
    # Retry an entirely empty response twice; these commands are all reads.
    # =========================================================================
    result=""
    _identity_attempt=1
    while [ "$_identity_attempt" -le 3 ] && [ -z "$result" ]; do
        result=$(qcmd 'AT+CVERSION;+CGMM;+CGSN;+CIMI;+QCCID;+CNUM' 2>/dev/null)
        if [ -z "$result" ] && [ "$_identity_attempt" -lt 3 ]; then
            qlog_warn "Boot identity query returned no response; retrying ($_identity_attempt/3)"
            sleep 1
        fi
        _identity_attempt=$((_identity_attempt + 1))
    done

    if [ -n "$result" ]; then
        # CVERSION: prefixed lines — parsers already grep by prefix
        parse_version "$result"

        # CGMM: bare model name — the only non-numeric, non-prefixed single
        # line between the CVERSION block and the bare 15-digit numbers.
        # Extract as: first line after Authors: block that isn't blank/prefix/digits.
        boot_model=$(printf '%s\n' "$result" | tr -d '\r' | \
            grep -v '^AT' | grep -v '^OK$' | grep -v '^$' | \
            grep -v '^VERSION:' | grep -v '^Authors:' | \
            grep -v '^[0-9]' | grep -v '^+' | \
            grep -v '^[A-Z][a-z][a-z] ' | \
            head -1)

        # CGSN / CIMI: bare 15-digit numbers, order-based extraction
        boot_imei=$(printf '%s\n' "$result" | tr -d '\r' | grep -x '[0-9]\{15\}' | sed -n '1p')
        boot_imsi=$(printf '%s\n' "$result" | tr -d '\r' | grep -x '[0-9]\{15\}' | sed -n '2p')

        # QCCID: prefixed
        boot_iccid=$(printf '%s\n' "$result" | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')

        # CNUM: prefixed. Always RESET boot_phone_number (no `[ -n ] &&` guard)
        # so a blank/absent CNUM yields "" rather than leaving a PREVIOUS
        # SIM's number in place after a failover to a SIM with no provisioned
        # MSISDN. Extraction anchors on the trailing quoted-number,type shape
        # (`,"<number>",<type>` at end of line) rather than a raw `cut -f2`,
        # since a carrier-populated alpha field containing its own comma
        # would otherwise shift which field `cut` lands on.
        local num
        num=$(printf '%s\n' "$result" | grep '+CNUM:' | head -1 | tr -d '\r')
        num=$(printf '%s\n' "$num" | sed -n 's/.*,"\([+0-9]*\)",[0-9]*[[:space:]]*$/\1/p')
        boot_phone_number="$num"

    fi

    # QGETCAPABILITY is optional on deployment variants. Keep its failure from
    # poisoning the identity fields above; supported-band policy is collected
    # separately below and remains the primary band source.
    local capability_result
    _bt_mark identity
    capability_result=$(qcmd 'AT+QGETCAPABILITY' 2>/dev/null)
    if [ -n "$capability_result" ]; then
        parse_capability "$capability_result"
    fi

    _bt_mark capability
    # --- SIM Swap Detection (boot-time, one-shot) — known-SIMs set model ---
    # "New SIM" = boot_iccid is not a member of the persistent known-SIMs set.
    # On a truly fresh device (no prior known set, no legacy last_iccid),
    # _had_prior_sim_db stays 0 so we never false-fire on the first-ever SIM.
    # sim_db_seed_if_absent() migrates the retired /etc/qmanager/last_iccid
    # forward on first run — that file is left on disk untouched otherwise.
    SIM_SWAP_FLAG="/tmp/qmanager_sim_swap_detected"
    local _had_prior_sim_db
    _had_prior_sim_db=0
    if sim_db_seed_if_absent; then _had_prior_sim_db=1; fi
    if [ -n "$boot_iccid" ]; then
        if [ "$_had_prior_sim_db" = "1" ] && ! sim_db_known "$boot_iccid"; then
            qlog_warn "NEW SIM DETECTED: ...$(printf '%s' "$boot_iccid" | tail -c 4) not in known set"
            local match_name=""
            local match_id=""
            local pf
            for pf in /etc/qmanager/profiles/*.json; do
                [ -f "$pf" ] || continue
                local pf_iccid
                pf_iccid=$(jq -r '(.sim_iccid) | if . == null then empty else . end' "$pf" 2>/dev/null)
                if [ "$(iccid_canonicalize "$pf_iccid")" = "$(iccid_canonicalize "$boot_iccid")" ]; then
                    match_name=$(jq -r '(.name) | if . == null then empty else . end' "$pf" 2>/dev/null)
                    match_id=$(jq -r '(.id) | if . == null then empty else . end' "$pf" 2>/dev/null)
                    break
                fi
            done
            # previous_iccid kept for shape-compat (frontend ignores it); there
            # is no single "previous" in a set model, so it is always empty.
            jq -n -c \
                --argjson ts "$(date +%s)" \
                --arg prev "" \
                --arg curr "$boot_iccid" \
                --arg pid "$match_id" \
                --arg pname "$match_name" \
                '{detected_at:$ts,previous_iccid:$prev,current_iccid:$curr,matching_profile_id:$pid,matching_profile_name:$pname,dismissed:false}' \
                > "$SIM_SWAP_FLAG"
            append_event "sim_swap_detected" "New SIM detected (ICCID ...$(printf '%s' "$boot_iccid" | tail -c 4))" "info"

            # Persistent registry record — this is the ONLY site that seeds a
            # fresh, undismissed record (first_seen=now). Gated on the SAME
            # _had_prior_sim_db check as the /tmp flag above, so a genuinely
            # fresh device (no prior known-SIMs set) never gets a bogus
            # first-boot record either — matches the /tmp flag's existing
            # suppression exactly. t2_carrier is still "" this early in boot
            # (Tier 2 hasn't run yet); the Tier 2 refresh backfills it within
            # the first poll cycle (TIER2_EVERY divides cycle_count=0).
            sim_registry_seed_new "$boot_iccid" "$t2_carrier" "$boot_phone_number"
        fi
        sim_db_add "$boot_iccid"

        # --- Auto-deactivate profile on SIM mismatch ---
        # If the active profile was created for a different SIM, clear it so
        # the UI no longer shows a stale "Active" badge.
        local _ap_file="/etc/qmanager/active_profile"
        if [ -f "$_ap_file" ]; then
            local _ap_id
            local _ap_iccid
            local _ap_name
            _ap_id=$(cat "$_ap_file" 2>/dev/null | tr -d ' \r\n')
            if [ -n "$_ap_id" ] && [ -f "/etc/qmanager/profiles/${_ap_id}.json" ]; then
                _ap_iccid=$(jq -r '(.sim_iccid) | if . == null then empty else . end' "/etc/qmanager/profiles/${_ap_id}.json" 2>/dev/null)
                if [ -n "$_ap_iccid" ] && [ "$(iccid_canonicalize "$_ap_iccid")" != "$(iccid_canonicalize "$boot_iccid")" ]; then
                    _ap_name=$(jq -r '(.name) | if . == null then empty else . end' "/etc/qmanager/profiles/${_ap_id}.json" 2>/dev/null)
                    rm -f "$_ap_file"
                    qlog_warn "Auto-deactivated profile '$_ap_name' — SIM ICCID mismatch (profile: ...$(printf '%s' "$_ap_iccid" | tail -c 4), current: ...$(printf '%s' "$boot_iccid" | tail -c 4))"
                    append_event "profile_deactivated" "Profile '$_ap_name' auto-deactivated (SIM mismatch)" "warning"
                fi
            fi
        fi
    fi

    # =========================================================================
    # Pre-boot serving cell — needed to gate MIMO reads by network mode
    # =========================================================================
    poll_serving_cell
    sleep "$SIP_DELAY"

    # =========================================================================
    # Group B: Enables + post-enable reads — split into 4 independent qcmd
    # calls (was 1 seven-command line). qcmd fails the ENTIRE response if the
    # word ERROR appears ANYWHERE in it (qcmd:175), so one transient failure
    # in a single chained command used to blank every field in the chain.
    # Measured live on RG501Q-EU: this exact 7-command line errored once,
    # right at boot, then succeeded when re-run seconds later — a startup
    # race (radio subsystem not fully up yet), not a missing command. The
    # sub-groups below cost the same commands and locks, just fewer eggs
    # per basket: a race in B1/B2 is masked anyway by the Tier 2 MIMO
    # refresh (poller:1441+), and a race in B3/B4 now only blanks its own
    # small group instead of all of IP Passthrough + MIMO.
    # =========================================================================

    _bt_mark sim_and_serving
    # --- B1: CA snapshot at boot, then enable MIMO/timing reporting ONLY for
    # B2's reads (v0.1.34 hotfix — see ca_ext_on()'s header). Upstream left
    # this latched on permanently and firmware dropped the connection repeatedly.
    # QCAINFO goes through ca_info_read, which owns its own =1/read/=0. ---
    result=$(ca_info_read)
    if [ -n "$result" ]; then
        parse_ca_info "$result"
    fi
    ca_ext_on
    sleep "$SIP_DELAY"

    # --- B2: mode-appropriate MIMO read (lte_mimo_layers crashes in SA,
    # nr5g_mimo_layers crashes in LTE/NSA — same gate as before) ---
    if [ "$network_type" = "5G-SA" ]; then
        result=$(qcmd 'AT+QNWCFG="nr5g_mimo_layers"' 2>/dev/null)
        [ -n "$result" ] && parse_mimo "" "$result"
    elif [ "$network_type" = "LTE" ] || [ "$network_type" = "5G-NSA" ]; then
        result=$(qcmd 'AT+QNWCFG="lte_mimo_layers"' 2>/dev/null)
        [ -n "$result" ] && parse_mimo "$result" ""
    fi
    # Reporting off again: it must not outlive the reads above (v0.1.34).
    ca_ext_off
    sleep "$SIP_DELAY"

    # --- B3: IP Passthrough MPDN rule + NAT ---
    # The RG520N-EB answers ERROR to both QMAP commands; probing them every
    # boot only fills System > Logs with expected errors and needlessly holds
    # the AT flock. Leave the initialized safe defaults (disabled / NAT=1).
    # When this page is explicitly opened, its endpoint may probe capabilities
    # on demand; the dashboard does not need these fields.
    boot_ippt_mode="disabled"
    boot_ippt_mac=""
    boot_ippt_nat="1"
    sleep "$SIP_DELAY"

    _bt_mark ca_mimo
    # --- B4: IP Passthrough usbnet mode (own AT+QCFG subsystem, own call) ---
    result=$(qcmd 'AT+QCFG="usbnet"' 2>/dev/null)
    if [ -n "$result" ]; then
        parse_ippt_usbnet "$result"
    fi

    # QMAP LANIP is unsupported on the RG520N-EB. Read the gateway from the
    # actual bridge address instead; this also works across firmware variants.
    resolve_kernel_addressing

    # QMAP DHCPV4DNS is unsupported on this firmware; keep the initialized
    # "disabled" value rather than logging a known ERROR at every boot.

    # =========================================================================
    # Supported bands — conditional (cached to /tmp across hotplug restarts)
    # On full device reboot /tmp is cleared, so queried once then cached.
    # =========================================================================
    _bt_mark usbnet_addr
    SUPPORTED_BANDS_FILE="/tmp/qmanager_supported_bands.env"
    if [ -f "$SUPPORTED_BANDS_FILE" ]; then
        . "$SUPPORTED_BANDS_FILE"
        qlog_info "Loaded supported bands from RAM cache"
    else
        result=$(qcmd_exec 'AT+QNWPREFCFG="policy_band"')
        if [ $? -eq 0 ]; then
            parse_policy_band "$result"
            printf 'boot_supported_lte_bands="%s"\nboot_supported_nsa_nr5g_bands="%s"\nboot_supported_sa_nr5g_bands="%s"\n' \
                "$boot_supported_lte_bands" "$boot_supported_nsa_nr5g_bands" "$boot_supported_sa_nr5g_bands" \
                > "$SUPPORTED_BANDS_FILE"
            qlog_info "Supported bands cached to $SUPPORTED_BANDS_FILE"
        fi
    fi

    # =========================================================================
    # Active profile auto-apply at boot
    # =========================================================================
    # If ICCID matches a saved profile, (re-)apply all its settings.
    # The apply script skips any setting that already matches — no-op if
    # nothing drifted. Also handles SIM swap: if the old active profile was
    # deactivated above (ICCID mismatch), this finds and applies the profile
    # for the new SIM instead.
    # =========================================================================
    if [ -n "$boot_iccid" ]; then
        auto_apply_profile "$boot_iccid" "boot"
    fi

    _bt_mark bands_profile
    local _bt_tot _bt_up
    printf -v _bt_tot '%d.%02d' $(( (_BT_NOW - _BT_START) / 100 )) $(( (_BT_NOW - _BT_START) % 100 ))
    printf -v _bt_up '%d.%02d' $(( _BT_NOW / 100 )) $(( _BT_NOW % 100 ))
    log_info "Boot data timing (s): total=${_bt_tot}${_BT} | kernel uptime at end ${_bt_up}"
    log_info "Boot data: FW=$boot_firmware BUILD=$boot_build_date MFG=$boot_manufacturer MODEL=$boot_model"
    log_info "Boot data: IMEI=$boot_imei IMSI=$boot_imsi ICCID=$boot_iccid"
    log_info "Boot data: PHONE=$boot_phone_number CAT=$boot_lte_category MIMO=$t2_mimo"
    log_info "Boot data: LTE_BANDS=$boot_supported_lte_bands NSA_BANDS=$boot_supported_nsa_nr5g_bands SA_BANDS=$boot_supported_sa_nr5g_bands"
    log_info "Boot data: IPPT mode=$boot_ippt_mode nat=$boot_ippt_nat usb=$boot_ippt_usbnet dns=$boot_ippt_dhcpv4dns"
    log_info "Boot data: LAN ip=$boot_lan_ip gateway=$boot_lan_gateway"
}

# =============================================================================
# read_sim_identity — Re-read SIM-bound identifiers (IMSI, ICCID)
# =============================================================================
# Called from the Tier 2 force-refresh path after a user-initiated SIM slot
# swap. Only refreshes fields that actually change with the SIM card —
# leaves IMEI / model / firmware / capability alone (those are modem-bound
# and a SIM swap can't affect them).
#
# Response shape differs from collect_boot_data's compound read. Standalone CIMI
# returns a single bare 15-digit number (no IMEI prefix line to disambiguate),
# so we use `head -1` instead of `sed -n '2p'`.
# =============================================================================
read_sim_identity() {
    local result new_imsi new_iccid
    result=$(qcmd 'AT+CIMI;+QCCID' 2>/dev/null)
    [ -z "$result" ] && return 0

    new_imsi=$(printf '%s\n' "$result" | tr -d '\r' | grep -x '[0-9]\{15\}' | head -1)
    new_iccid=$(printf '%s\n' "$result" | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')

    [ -n "$new_imsi" ] && boot_imsi="$new_imsi"
    [ -n "$new_iccid" ] && boot_iccid="$new_iccid"
}

# =============================================================================
# TIER 1: HOT DATA (every cycle)
# =============================================================================

poll_serving_cell() {
    local result
    result=$(qcmd_exec 'AT+QENG="servingcell"')
    serving_cell_apply $? "$result"
}

# Tier 1 in ONE AT round-trip: serving cell + the CA read (with its =1/=0
# toggle) as a single compound. Two separate calls cost ~53 ms of CPU and
# ~0.35 s of AT-lock time EACH on the RG520N-EB; the compound is one call,
# ~0.6 s (measured 2026-10-22, 340-byte reply — needs the shim's 4 KiB read).
# parse_serving_cell only reads ^+QENG: lines and parse_ca_info only +QCAINFO
# lines, so both parse the same text.
# On ANY failure it falls back to the old two-call sequence, so one rejected
# command can never cost the other's data (`qcmd` drops a whole compound on
# ERROR), and QCAINFO=0 is re-sent first in case the compound stopped after =1.
# If the serving cell alone also fails the modem is unreachable and the CA read
# is skipped, so an outage costs the same number of AT calls as before.
T1_COMBINED='AT+QENG="servingcell";+QCAINFO=1;+QCAINFO;+QCAINFO=0'
poll_tier1_at() {
    local _t1 _rc
    _t1=$(qcmd_exec "$T1_COMBINED")
    _rc=$?
    if [ "$_rc" -eq 0 ] && [ -n "$_t1" ]; then
        serving_cell_apply 0 "$_t1"
        parse_ca_info "$_t1"
        return 0
    fi
    qcmd "$CA_INFO_OFF" >/dev/null 2>&1
    poll_serving_cell
    if [ "$modem_reachable" = "true" ]; then
        sleep "$SIP_DELAY"
        _t1=$(ca_info_read)
        if [ $? -eq 0 ] && [ -n "$_t1" ]; then
            parse_ca_info "$_t1"
            return 0
        fi
    fi
    t2_ca_active=false
    t2_ca_count=0
    t2_nr_ca_active=false
    t2_nr_ca_count=0
    t2_total_bandwidth_mhz=0
    t2_bandwidth_details=""
    t2_carrier_components="[]"
    return 1
}

# Shared tail of the serving-cell read: $1 = qcmd_exec rc, $2 = its output.
serving_cell_apply() {
    local rc="$1" result="$2"

    if [ $rc -eq 0 ] || [ $rc -eq 2 ]; then
        if [ "$modem_reachable" != "true" ]; then
            qlog_state_change "modem_reachable" "false" "true"
        fi
        modem_reachable=true
        local prev_network_type="$network_type"
        local prev_lte_state="$lte_state"
        local prev_nr_state="$nr_state"
        parse_serving_cell "$result"
        # Log state transitions
        qlog_state_change "network_type" "$prev_network_type" "$network_type"
        qlog_state_change "lte_state" "$prev_lte_state" "$lte_state"
        qlog_state_change "nr_state" "$prev_nr_state" "$nr_state"
    else
        if [ "$modem_reachable" = "true" ]; then
            qlog_state_change "modem_reachable" "true" "false"
        fi
        modem_reachable=false
        system_state="degraded"
        lte_state="unknown"
        nr_state="unknown"
        errors="modem_timeout"
        log_warn "Modem unreachable during serving cell poll"
    fi
}

# =============================================================================
# TIER 1.5: PER-ANTENNA SIGNAL (every 5 cycles / 10s)
# =============================================================================
# Three AT commands (~200ms each = ~600ms total modem lock per cycle).
# Writes latest values to state vars AND appends to NDJSON history file.

poll_per_antenna_signal() {
    # Compound AT: fetch all per-antenna signal data in one call
    local result
    result=$(qcmd 'AT+QRSRP;+QRSRQ;+QSINR' 2>/dev/null)

    if [ -n "$result" ]; then
        parse_qrsrp "$result"
        parse_qrsrq "$result"
        parse_qsinr "$result"
    fi

    # Append to signal history
    append_signal_history
}

# Append current per-antenna values as one NDJSON line to the history file.
# Capped at SIGNAL_HISTORY_MAX lines (~30 min at 10s intervals).
append_signal_history() {
    local ts
    ts=$(date +%s)

    jq -n -c \
        --argjson ts "$ts" \
        --argjson lte_rsrp "$sig_lte_rsrp" \
        --argjson lte_rsrq "$sig_lte_rsrq" \
        --argjson lte_sinr "$sig_lte_sinr" \
        --argjson nr_rsrp "$sig_nr_rsrp" \
        --argjson nr_rsrq "$sig_nr_rsrq" \
        --argjson nr_sinr "$sig_nr_sinr" \
        '{ts:$ts, lte_rsrp:$lte_rsrp, lte_rsrq:$lte_rsrq, lte_sinr:$lte_sinr,
         nr_rsrp:$nr_rsrp, nr_rsrq:$nr_rsrq, nr_sinr:$nr_sinr}' >> "$SIGNAL_HISTORY_FILE"

    # Trim to max entries
    local count
    count=$(wc -l < "$SIGNAL_HISTORY_FILE" 2>/dev/null || echo 0)
    if [ "$count" -gt "$SIGNAL_HISTORY_MAX" ]; then
        local tmp="${SIGNAL_HISTORY_FILE}.tmp"
        tail -n "$SIGNAL_HISTORY_MAX" "$SIGNAL_HISTORY_FILE" > "$tmp"
        mv "$tmp" "$SIGNAL_HISTORY_FILE"
    fi
}

# Append the conn_ stats from read_ping_data() as one NDJSON line to the ping history file,
# capped at PING_HISTORY_MAX lines (rows land about every 16s on device, not 10s).
append_ping_history() {
    local ts
    ts=$(date +%s)

    jq -n -c \
        --argjson ts "$ts" \
        --argjson lat "${conn_latency:-null}" \
        --argjson avg "${conn_avg_latency:-null}" \
        --argjson min "${conn_min_latency:-null}" \
        --argjson max "${conn_max_latency:-null}" \
        --argjson loss "${conn_packet_loss:-null}" \
        --argjson jit "${conn_jitter:-null}" \
        '{ts:$ts,lat:$lat,avg:$avg,min:$min,max:$max,loss:$loss,jit:$jit}' >> "$PING_HISTORY_FILE"

    # Trim to max entries
    local count
    count=$(wc -l < "$PING_HISTORY_FILE" 2>/dev/null || echo 0)
    if [ "$count" -gt "$PING_HISTORY_MAX" ]; then
        local tmp="${PING_HISTORY_FILE}.tmp"
        tail -n "$PING_HISTORY_MAX" "$PING_HISTORY_FILE" > "$tmp"
        mv "$tmp" "$PING_HISTORY_FILE"
    fi
}

# =============================================================================
# TIER 3: PHY DEPTH (every TIER3_EVERY cycles, ~60s)
# =============================================================================
# CQI, RI, PMI, MIMO layers, TM mode, UL/DL MCS, NR TX power, RRC state and the
# SSB beam table — the physical layer none of the tiers above read. All of the
# reading lives in lib/qmanager/phy_metrics.sh (two compound AT commands at
# most, plus one `ubus call modemd status` which takes no AT lock); this function
# is only the composition and the publishing.
#
# WHY IT IS CALLED FROM main() AND NOT FROM THE CYCLE BODY: it holds the AT
# flock for ~1.2s, and `poll_cycle exceeded budget` has to keep meaning what it
# has always meant (Tier-1/AT slowness). Running it past the budget timer is the
# same placement the neighbour live tick uses, for the same reason. The cost is
# that the values reach /tmp/qmanager_status.json on the NEXT write_cache (~4s
# later), which is well inside one Tier-3 interval and never observable as
# stale by a browser polling at Tier-1 cadence.
#
# Freshness contract (spec R1): a field that this pass could not read is
# published as null — never 0 (0 is a measurement) and never the previous
# cycle's value, because a stale CQI presented as current is a lie the UI cannot
# detect.
poll_tier3() {
    local md="{}" at="{}" ctx snap cells ok

    # Never during a scan. The flag is this daemon's existing marker for "another
    # AT consumer owns the port" (cell scan, neighbour scan, tower lock work),
    # and Tier 3 is the one thing here that could queue behind it for 20s.
    if [ -f "$LONG_FLAG" ]; then
        return 0
    fi

    # The poller's own serving-cell figures, so the snapshot's RSRP/RSRQ/RSSI/SINR
    # match the cards above it instead of being a second reading of the same
    # thing. `:-null` covers the empty-string default of every one of these vars.
    ctx=$(jq -cn \
        --argjson lr "${lte_rsrp:-null}" --argjson lq "${lte_rsrq:-null}" \
        --argjson li "${lte_rssi:-null}" --argjson ls "${lte_sinr:-null}" \
        --argjson nr "${nr_rsrp:-null}" --argjson nq "${nr_rsrq:-null}" \
        --argjson ns "${nr_sinr:-null}" --arg car "${t2_carrier:-}" \
        '{lte_rsrp:$lr, lte_rsrq:$lq, lte_rssi:$li, lte_sinr:$ls,
          nr_rsrp:$nr, nr_rsrq:$nq, nr_sinr:$ns, carrier:$car}' 2>/dev/null)

    # Gate on a real modemd answer, not on a binary's presence (hard rule 8).
    # With the vendor modem daemon not answering, the AT half cannot populate the
    # fields this pass exists for, so it would spend two lock holds for nothing.
    # Both reads are skipped, and the null-filled snapshot below still publishes:
    # the UI then shows "—" rather than the previous cycle's values as current.
    if qm_phy_available; then
        md=$(qm_phy_modemd) || md="{}"
        [ "$md" = "{}" ] && qlog_debug "phy: modemd read failed"

        at=$(qm_phy_at "$network_type") || at="{}"
        [ "$at" = "{}" ] && qlog_debug "phy: AT read failed (network_type=${network_type:-unknown})"
    else
        qlog_debug "phy: ubus/modemd unavailable — Tier 3 publishes nulls"
    fi

    snap=$(qm_phy_snapshot "$md" "$at" "$ctx")
    # Never hand an unvalidated string to write_cache: it goes in as --argjson,
    # so one malformed byte would fail the WHOLE status-cache write and freeze
    # every page that reads it. The previous snapshot is kept instead.
    if [ -z "$snap" ] || ! printf '%s' "$snap" | jq -e . >/dev/null 2>&1; then
        qlog_warn "phy: snapshot is not valid JSON — keeping the previous one"
        return 1
    fi
    phy_json="$snap"

    # Nothing read at all: publish the nulls, but do not archive a row of them —
    # a minute-by-minute record of "the modem said nothing" is not a trend, and
    # 30 days of it would bury the data on either side.
    if [ "$md" = "{}" ] && [ "$at" = "{}" ]; then
        return 1
    fi

    # Durable trend row (spec R3). total_cells is the number of carrier
    # components the modem is aggregating — the rows the CA card shows — and is
    # null when that read produced nothing, because "0 cells" is not a possible
    # state for an attached modem.
    cells=$(printf '%s' "${t2_carrier_components:-[]}" \
        | jq -r 'if type == "array" and length > 0 then length else null end' 2>/dev/null)
    qm_phy_archive_row "$snap" "${t2_temperature:-null}" "${cells:-null}"
    ok=$?
    [ "$ok" -eq 0 ] || qlog_debug "phy: archive row not written (status ${ok})"
    return 0
}

# =============================================================================
# TIER 2: WARM DATA (every N cycles)
# =============================================================================

poll_tier2() {
    local result

    # Compound AT: status queries in one call.
    # CPIN? is last — it can ERROR when SIM is absent; placing it last
    # ensures earlier responses (COPS, QUIMSLOT, CNUM, QSIMSTAT) are preserved
    # even if the modem aborts on CPIN ERROR. QSIMSTAT? must sit BEFORE CPIN?
    # for the same reason it can't go last itself.
    #
    # QTEMP IS DELIBERATELY ABSENT. It used to lead this chain, and on the
    # RG520N-EB AT+QTEMP answers a bare ERROR, which ABORTS THE REST OF THE
    # CHAIN: measured, the whole compound returned a single "ERROR" — no COPS,
    # no QUIMSLOT, no CNUM, no QSIMSTAT, no CPIN. That is why the UI showed a
    # blank operator, blank phone number and "unknown" SIM state while the
    # modem was fine. Temperature no longer needs AT at all (parse_temperature
    # reads the thermal framework when QTEMP is silent), so drop it here rather
    # than leave a chain-killing command at its head.
    result=$(qcmd 'AT+COPS?;+QUIMSLOT?;+CNUM;+QSIMSTAT?;+CPIN?' 2>/dev/null)

    # Temperature runs OUTSIDE the non-empty guard below. AT+QTEMP is unsupported
    # on the RG520N-EB (bare "ERROR"), so parse_temperature falls back to the
    # thermal framework — and that fallback must still run when the whole
    # compound fails and `result` is empty, which is exactly the case the guard
    # used to swallow (temperature stayed null on a healthy modem).
    parse_temperature "$result"

    if [ -n "$result" ]; then
        parse_carrier "$result"
        parse_sim_slot "$result"
        parse_sim_inserted "$result"

        # Phone number refresh (may change on SIM swap). Always RESET (no
        # `[ -n ] &&` guard) so a blank CNUM after a failover to a SIM with
        # no provisioned MSISDN clears the PREVIOUS SIM's number instead of
        # leaving it displayed for the wrong SIM. Same trailing
        # quoted-number,type anchor as collect_boot_data's CNUM parse (see
        # there for why `cut -d',' -f2` is unsafe).
        local num
        num=$(printf '%s\n' "$result" | grep '+CNUM:' | head -1 | tr -d '\r')
        num=$(printf '%s\n' "$num" | sed -n 's/.*,"\([+0-9]*\)",[0-9]*[[:space:]]*$/\1/p')
        boot_phone_number="$num"

        # SIM status — extract CPIN line specifically (parse_sim_status uses
        # case matching, not grep, so pass only the relevant line)
        local cpin_line
        cpin_line=$(printf '%s\n' "$result" | grep '+CPIN:' | head -1)
        if [ -n "$cpin_line" ]; then
            parse_sim_status "$cpin_line"
        elif printf '%s\n' "$result" | grep -q 'CME ERROR'; then
            t2_sim_status="error"
            errors="sim_not_inserted"
        fi

        # Registry refresh (c): scoped carrier/phone_number update on the
        # ACTIVE record only — never touches dismissed/first_seen. No-ops
        # internally (no write) when neither value changed since last cycle.
        sim_registry_refresh_active "$boot_iccid" "$t2_carrier" "$boot_phone_number"
    fi
    sleep "$SIP_DELAY"

    # Network info split into 3 independent groups so that LTE errors
    # (in SA mode) or NR errors (in LTE-only) cannot kill the whole chain.

    # --- Group 1: APN + WAN IPs (always safe, mode-independent) ---
    # AT+QMAP="WWAN" is NOT included. It is unsupported on the RG520N-EB (bare
    # ERROR) and qcmd rejects a response containing ERROR, so the compound
    # yielded NOTHING — discarding the +CGCONTRDP answer that had already
    # arrived and leaving the APN and both DNS rows blank in the UI. The WAN
    # IPv4/IPv6 that QMAP would have supplied are recovered from the kernel by
    # resolve_kernel_addressing() below.
    result=$(qcmd 'AT+CGCONTRDP' 2>/dev/null)
    if [ -n "$result" ]; then
        if printf '%s\n' "$result" | grep -q '+CGCONTRDP:'; then
            parse_cgcontrdp "$result"
        else
            t2_apn="" ; t2_primary_dns="" ; t2_secondary_dns=""
        fi
    else
        t2_apn="" ; t2_primary_dns="" ; t2_secondary_dns=""
    fi

    # Fill whatever the modem could not tell us (WAN IPs, LAN gateway).
    resolve_kernel_addressing
    sleep "$SIP_DELAY"

    # --- Group 2: NR timing + MIMO ---
    # nr5g_mimo_layers is only valid in SA mode (crashes/errors in LTE & NSA)
    local nr_cmd='AT+QNWCFG="nr5g_time_advance"'
    if [ "$network_type" = "5G-SA" ]; then
        nr_cmd="${nr_cmd}"';+QNWCFG="nr5g_mimo_layers"'
    fi
    result=$(ca_ext_read "$nr_cmd")
    if [ -n "$result" ]; then
        parse_time_advance "$result"
        parse_mimo "" "$result"
    fi
    # NO else-branch resetting nr_ta to "". An empty result means the modem did
    # not answer (AT lock timeout or a dropped command), which is NOT the same as
    # "this cell has no timing advance". Clearing it blanked the dashboard's Cell
    # Distance rows until the next Tier 2 pass (15 cycles). The UI already gates
    # these figures on modem_reachable, so a stale-but-real value is correct.
    sleep "$SIP_DELAY"

    # --- Group 3: LTE timing + MIMO ---
    # lte_mimo_layers is valid in LTE and NSA (crashes/errors in SA)
    local lte_cmd='AT+QNWCFG="lte_time_advance"'
    if [ "$network_type" = "LTE" ] || [ "$network_type" = "5G-NSA" ]; then
        lte_cmd="${lte_cmd}"';+QNWCFG="lte_mimo_layers"'
    fi
    result=$(ca_ext_read "$lte_cmd")
    if [ -n "$result" ]; then
        parse_time_advance "$result"
        parse_mimo "$result" ""
    fi
    # Same reason as the NR group above: never blank a good reading on a
    # transient empty response.

    # NOTE — the LTE timing advance from THIS firmware is not trustworthy as a
    # plain 3GPP N_TA, so it is deliberately NOT rescaled here.
    #
    # Measured on the O5A Pro, stable across samples: lte_time_advance=1968 while
    # nr5g_time_advance=25600. Under the standard formulas that is ~9.6 km for the
    # LTE anchor and ~2.0 km for the NR cell. The owner confirmed the tower is at
    # most 2.5 km away, which rules out the LTE figure, and no 3GPP-justified
    # reading of 1968 produces ~2 km (as an index it is above the 1282 ceiling; as
    # N_TA it is 9.6 km). An earlier revision divided values above 1282 by 16 to
    # force a plausible number — that was a guess, and the ground truth disproved
    # it, so it is gone. The raw value is published as-is and the dashboard's own
    # range check decides whether it can render a distance.
    #
    # If a future Quectel manual documents this field, revisit here rather than
    # reintroducing a fudge factor.
}

# =============================================================================
# SERVICE QUALITY ASSESSMENT
# =============================================================================

determine_service_status() {
    # Reset every cycle so a stale value cannot survive ambiguous inputs.
    service_status="unknown"

    if [ "$modem_reachable" != "true" ]; then
        return
    fi

    if [ "$t2_sim_status" = "not_inserted" ] || [ "$t2_sim_status" = "error" ]; then
        service_status="sim_error"
        return
    fi

    if { [ "$lte_state" = "disconnected" ] || [ "$lte_state" = "unknown" ]; } && [ "$nr_state" != "connected" ]; then
        service_status="no_service"
        return
    fi

    if [ "$lte_state" = "searching" ]; then
        service_status="searching"
        return
    fi

    # Pick the primary RSRP — NR if connected, else LTE
    local primary_rsrp=""
    if [ "$nr_state" = "connected" ] && [ -n "$nr_rsrp" ]; then
        primary_rsrp=$nr_rsrp
    elif [ -n "$lte_rsrp" ]; then
        primary_rsrp=$lte_rsrp
    fi

    if [ -n "$primary_rsrp" ] && [ "$primary_rsrp" -gt -100 ] 2>/dev/null; then
        service_status="optimal"
    elif [ -n "$primary_rsrp" ]; then
        service_status="connected"
    elif [ "$lte_state" = "connected" ] || [ "$nr_state" = "connected" ]; then
        # Registered but signal not yet sampled this cycle — keep "connected"
        # rather than the default "unknown".
        service_status="connected"
    fi
}

# =============================================================================
# CONNECTIVITY DATA (from ping daemon — no modem lock needed)
# =============================================================================

PING_CACHE="/tmp/qmanager_ping.json"
PING_HISTORY_RAW="/tmp/qmanager_ping_history"   # flat-file ring buffer from ping daemon
PING_DAEMON_STALE_EVENT_THRESHOLD=60  # seconds before emitting ping_daemon_stale

# Staleness and the ping.json read live in conn_state.sh (shared with watchcat).

# DNS lookup time from qmanager_ping's detached job. A number only when the last
# lookup succeeded and the sample is fresh (mono age 0..DNS_MAX_AGE_SEC).
DNS_CACHE="${DNS_CACHE:-/tmp/qmanager_dns.json}"
DNS_MAX_AGE_SEC=180
dns_lookup_ms="null"
dns_resolver=""

read_dns_data() {
    dns_lookup_ms="null"
    dns_resolver=""
    [ -f "$DNS_CACHE" ] || return 0

    local _row _ok _ms _mono _res _up _idle _age
    _row=$(jq -r '[(.ok|tostring), (.ms|tostring), (.mono|tostring), (.resolver|tostring)] | @tsv' \
        "$DNS_CACHE" 2>/dev/null </dev/null)
    [ -n "$_row" ] || return 0
    IFS=$'\t' read -r _ok _ms _mono _res <<< "$_row"

    case "$_mono" in ''|*[!0-9]*) return 0 ;; esac
    { read -r _up _idle < /proc/uptime; } 2>/dev/null
    _up="${_up%%.*}"
    case "$_up" in ''|*[!0-9]*) return 0 ;; esac
    _age=$((_up - _mono))
    { [ "$_age" -ge 0 ] && [ "$_age" -le "$DNS_MAX_AGE_SEC" ]; } || return 0

    case "$_res" in ''|null) ;; *) dns_resolver="$_res" ;; esac
    if [ "$_ok" = "true" ]; then
        case "$_ms" in ''|*[!0-9]*) ;; *) dns_lookup_ms="$_ms" ;; esac
    fi
    return 0
}

read_ping_data() {
    # Pick up a Connection Quality save (or the first load) before the verdict below.
    cq_thresholds_refresh

    # Reset to defaults if ping file missing or stale
    if [ ! -f "$PING_CACHE" ]; then
        conn_internet_available="null"
        conn_status="unknown"
        conn_latency="null"
        conn_avg_latency="null"
        conn_min_latency="null"
        conn_max_latency="null"
        conn_jitter="null"
        conn_packet_loss="null"
        conn_ping_target=""
        conn_history="[]"
        conn_history_interval=0
        conn_during_recovery="false"
        conn_profile="unknown"
        conn_last_family="null"
        _ping_stale_since=0
        return
    fi

    # One shared read + staleness verdict (empty/unreadable cache = stale).
    local ping_ts now
    now=$(date +%s)
    if ! conn_state_read; then
        qlog_warn "Ping data stale ($(conn_state_why)), marking unknown"
        conn_internet_available="null"
        conn_status="unknown"
        conn_latency="null"
        conn_avg_latency="null"
        conn_min_latency="null"
        conn_max_latency="null"
        conn_jitter="null"
        conn_packet_loss="null"
        conn_history="[]"
        conn_history_interval=0
        conn_during_recovery="false"
        conn_profile="unknown"
        conn_last_family="null"

        # One-shot ping_daemon_stale event after sustained staleness;
        # _ping_stale_since is 0 (not tracking) or the epoch it began/last fired.
        if [ "$_ping_stale_since" -eq 0 ] 2>/dev/null; then
            _ping_stale_since=$now
        else
            local stale_dur=$((now - _ping_stale_since))
            if [ "$stale_dur" -ge "$PING_DAEMON_STALE_EVENT_THRESHOLD" ] 2>/dev/null; then
                append_event "ping_daemon_stale" \
                    "Ping daemon stale, alerts may be missed" \
                    "warning"
                _ping_stale_since=$now
            fi
        fi
        return
    fi
    # Fresh data — clear any stale-tracking state.
    _ping_stale_since=0

    ping_ts="$CQ_TIMESTAMP"
    local _first_target="$CQ_TARGET"
    local _last_target="$CQ_LAST_TARGET"
    conn_internet_available="$CQ_REACHABLE"
    conn_latency="$CQ_RTT_MS"
    conn_during_recovery="$CQ_DURING_RECOVERY"
    conn_history_interval="$CQ_INTERVAL_SEC"
    conn_profile="${CQ_PROFILE:-unknown}"
    conn_last_family="${CQ_LAST_FAMILY:-null}"

    # ping_target names the leg that ACTUALLY answered, not the first one
    # configured. The chain short-circuits, so targets[0] is only the winner on
    # a link where the first leg answers; on a device whose carrier blocks that
    # target, reporting it names a host that never replied while the latency
    # chart beside it belongs to a different one. targets[0] remains the honest
    # fallback for "nothing has answered yet".
    if [ -n "$_last_target" ]; then
        conn_ping_target="$_last_target"
    else
        conn_ping_target="$_first_target"
    fi

    # Step B: Single awk pass — only when ping timestamp changed (saves awk fork every 2s)
    # With ping daemon at 5s, awk runs ~every 5s instead of every cycle.
    if [ "$ping_ts" != "$_last_ping_ts" ]; then
        _last_ping_ts="$ping_ts"

        local _ha=""
        if [ -s "$PING_HISTORY_RAW" ]; then
            _ha=$(awk -v mins="$MIN_STAT_SAMPLES" '
            BEGIN { n=0; lost=0; nv=0; have=0; sum=0; jsum=0 }
            {
                n++; arr[n]=$0
                if ($0=="null") { lost++ }
                else {
                    val=$0+0; sum+=val; nv++
                    if (!have||val<min) min=val
                    if (!have||val>max) max=val
                    have=1
                    if (nv>1) { d=val-prev; if(d<0)d=-d; jsum+=d }
                    prev=val
                }
            }
            END {
                # Loss and jitter are RATIOS over the window, so unlike
                # min/avg/max (point statistics, honest at one sample) they
                # say nothing until the window is long enough to carry one.
                # Below mins they are emitted as the literal string null --
                # the same idiom the latency stats already use at nv==0 --
                # and never as 0, which every consumer reads as a MEASURED
                # perfect link. See MIN_STAT_SAMPLES for why the floor is 10.
                if (n >= mins)  lossout = sprintf("%d", int(lost*100/n)); else lossout = "null"
                if (nv >= mins) jitout  = sprintf("%.1f", (nv>1?jsum/(nv-1):0)); else jitout = "null"
                if (nv>0)
                    printf "%.1f|%.1f|%.1f|%s|%s|", min,sum/nv,max,jitout,lossout
                else
                    printf "null|null|null|%s|%s|", jitout,lossout
                printf "["
                for(i=1;i<=n;i++) { if(i>1) printf ","; printf "%s",arr[i] }
                printf "]\n"
            }' "$PING_HISTORY_RAW")
        fi

        if [ -n "$_ha" ]; then
            local _rest="$_ha"
            conn_min_latency="${_rest%%|*}";  _rest="${_rest#*|}"
            conn_avg_latency="${_rest%%|*}";  _rest="${_rest#*|}"
            conn_max_latency="${_rest%%|*}";  _rest="${_rest#*|}"
            conn_jitter="${_rest%%|*}";       _rest="${_rest#*|}"
            conn_packet_loss="${_rest%%|*}";  _rest="${_rest#*|}"
            conn_history="${_rest}"           # remaining is "[json_array]"
        else
            conn_min_latency="null"
            conn_avg_latency="null"
            conn_max_latency="null"
            conn_jitter="null"
            conn_packet_loss="null"
            conn_history="[]"
        fi
    fi
    # (if ts unchanged: cached conn_* stats remain valid)

    # Derive connectivity status from ping data + modem state
    if [ "$conn_during_recovery" = "true" ]; then
        conn_status="recovery"
    elif [ "$conn_internet_available" = "true" ]; then
        # Degraded = loss at or above the configured Connection Quality cut. Null loss
        # (window too short) is unknown, not evidence of degradation: connected.
        if [ "$conn_packet_loss" != "null" ] && [ "$conn_packet_loss" -ge "$CQ_LOSS_PCT" ] 2>/dev/null; then
            conn_status="degraded"
        else
            conn_status="connected"
        fi
    elif [ "$conn_internet_available" = "false" ]; then
        conn_status="disconnected"
    else
        conn_status="unknown"
    fi

    # Sanitize: ensure numeric fields are valid. "null" is a legitimate value
    # here (loss not yet measurable), so it passes; anything else unparseable
    # degrades to null too -- never to 0, which would read as a perfect link.
    case "$conn_packet_loss" in
        null) ;;
        ''|*[!0-9]*) conn_packet_loss="null" ;;
    esac
    case "$conn_history_interval" in
        *[!0-9]*|'') conn_history_interval=5 ;;
    esac
}

# =============================================================================
# MODEM CRASH WATCHER (sysfs subsys0/crash_count)
# =============================================================================
# Runs once at startup (crash_watcher_init) and once per Tier 1 cycle
# (crash_watcher_check). Uses two global state variables declared above:
#   _crash_watcher_enabled  — false if sysfs path absent (RM551E / unknown hw)
#   _last_crash_count       — last-known value; updated on every change

crash_watcher_init() {
    if [ ! -f "$_CRASH_COUNT_SYSFS" ]; then
        qlog_warn "modem crash watcher disabled — sysfs path absent"
        _crash_watcher_enabled=false
        return
    fi
    _crash_watcher_enabled=true

    local current_count
    current_count=$(cat "$_CRASH_COUNT_SYSFS" 2>/dev/null | tr -d '[:space:]')
    # If unreadable even though the file exists, treat as 0 (safe baseline)
    case "$current_count" in
        ''|*[!0-9]*) current_count=0 ;;
    esac

    if [ -f "$_CRASH_SIDECAR" ]; then
        # Load persisted last-known count
        local saved
        saved=$(cat "$_CRASH_SIDECAR" 2>/dev/null | tr -d '[:space:]')
        case "$saved" in
            ''|*[!0-9]*) saved=0 ;;
        esac
        _last_crash_count=$saved
        qlog_info "crash watcher: loaded sidecar last_count=${_last_crash_count} current=${current_count}"
    else
        # First run — establish baseline without writing a crash log entry
        _last_crash_count=$current_count
        printf '%s\n' "$current_count" > "${_CRASH_SIDECAR}.tmp" && \
            mv "${_CRASH_SIDECAR}.tmp" "$_CRASH_SIDECAR"
        qlog_info "crash watcher: baseline established count=${current_count}"
    fi
}

crash_watcher_check() {
    # Fast-exit if disabled (sysfs absent — RM551E or unsupported hw)
    if [ "$_crash_watcher_enabled" != "true" ]; then
        return
    fi

    local new_count
    new_count=$(cat "$_CRASH_COUNT_SYSFS" 2>/dev/null | tr -d '[:space:]')
    case "$new_count" in
        ''|*[!0-9]*)
            # Unreadable this cycle — skip silently (transient sysfs glitch)
            return
            ;;
    esac

    # No change — common case, returns immediately
    if [ "$new_count" -eq "$_last_crash_count" ] 2>/dev/null; then
        return
    fi

    # Counter decreased — modem reset zeroed the counter; re-baseline silently
    if [ "$new_count" -lt "$_last_crash_count" ] 2>/dev/null; then
        qlog_info "crash watcher: counter reset (${_last_crash_count} → ${new_count}), re-baselining"
        _last_crash_count=$new_count
        printf '%s\n' "$new_count" > "${_CRASH_SIDECAR}.tmp" && \
            mv "${_CRASH_SIDECAR}.tmp" "$_CRASH_SIDECAR"
        return
    fi

    # Counter incremented — log the crash event
    local prev_count="$_last_crash_count"
    local ts
    ts=$(date +%s)

    # Read modem state from sysfs; lowercase-normalise; default "unknown"
    local raw_state modem_state_at_event
    raw_state=$(cat "$_CRASH_STATE_SYSFS" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    case "$raw_state" in
        online|offline|crashed) modem_state_at_event="$raw_state" ;;
        *) modem_state_at_event="unknown" ;;
    esac

    # Uptime is already populated by update_proc_metrics earlier this cycle
    local uptime_now="${uptime_seconds:-0}"

    # Build the new entry using jq (no hand-rolled JSON)
    local new_entry
    new_entry=$(jq -n \
        --argjson ts "$ts" \
        --argjson prev "$prev_count" \
        --argjson new  "$new_count" \
        --arg     state "$modem_state_at_event" \
        --argjson uptime "$uptime_now" \
        '{ts: $ts, previous_count: $prev, new_count: $new,
          modem_state_at_event: $state, uptime_at_event_seconds: $uptime}')

    if [ -z "$new_entry" ]; then
        qlog_error "crash watcher: jq failed to build entry — skipping log write"
        return
    fi

    # Read existing log (treat missing/empty/corrupt file as empty array)
    local existing_log
    existing_log=$(jq '.' "$_CRASH_LOG" 2>/dev/null)
    case "$existing_log" in
        '['*) : ;;   # valid array — keep as-is
        *)    existing_log='[]' ;;
    esac

    # Append new entry and cap at 100 most-recent, then atomic-write
    printf '%s\n' "$existing_log" | \
        jq --argjson entry "$new_entry" \
           '. + [$entry] | if length > 100 then .[-100:] else . end' \
        > "${_CRASH_LOG}.tmp" && \
        mv "${_CRASH_LOG}.tmp" "$_CRASH_LOG"

    # Update sidecar atomically
    printf '%s\n' "$new_count" > "${_CRASH_SIDECAR}.tmp" && \
        mv "${_CRASH_SIDECAR}.tmp" "$_CRASH_SIDECAR"

    _last_crash_count=$new_count
    qlog_info "crash watcher: modem crash detected (${prev_count} → ${new_count}), state=${modem_state_at_event}"
}

# =============================================================================
# WATCHCAT & SIM STATE READERS
# =============================================================================

# Watchcat state variables (populated by read_watchcat_state)
wc_enabled="false"
wc_state="disabled"
wc_current_tier=0
wc_failure_count=0
wc_last_recovery_time="null"
wc_last_recovery_tier="null"
wc_total_recoveries=0
wc_cooldown_remaining=0
wc_reboots_this_hour=0
WATCHCAT_CACHE="/tmp/qmanager_watchcat.json"

# SIM failover state variables
sim_fo_active="false"
sim_fo_original_slot="null"
sim_fo_current_slot="null"
sim_fo_switched_at="null"
SIM_FAILOVER_FILE="/etc/qmanager/qmanager_sim_failover"

# SIM swap detection state variables
sim_swap_detected="false"
sim_swap_profile_id=""
sim_swap_profile_name=""

read_watchcat_state() {
    if [ ! -f "$WATCHCAT_CACHE" ]; then
        wc_enabled="false"; wc_state="disabled"
        return
    fi
    local _wdata
    _wdata=$(jq -r '[
        ((.enabled) | if . == null then "false" else tostring end),
        (.state // "unknown"),
        ((.current_tier) | if . == null then "0" else tostring end),
        ((.failure_count) | if . == null then "0" else tostring end),
        ((.last_recovery_time) | if . == null then "null" else tostring end),
        ((.last_recovery_tier) | if . == null then "null" else tostring end),
        ((.total_recoveries) | if . == null then "0" else tostring end),
        ((.cooldown_remaining) | if . == null then "0" else tostring end),
        ((.reboots_this_hour) | if . == null then "0" else tostring end)
    ] | @tsv' "$WATCHCAT_CACHE" 2>/dev/null)

    [ -z "$_wdata" ] && return

    wc_enabled=$(printf '%s' "$_wdata" | cut -f1)
    wc_state=$(printf '%s' "$_wdata" | cut -f2)
    wc_current_tier=$(printf '%s' "$_wdata" | cut -f3)
    wc_failure_count=$(printf '%s' "$_wdata" | cut -f4)
    wc_last_recovery_time=$(printf '%s' "$_wdata" | cut -f5)
    wc_last_recovery_tier=$(printf '%s' "$_wdata" | cut -f6)
    wc_total_recoveries=$(printf '%s' "$_wdata" | cut -f7)
    wc_cooldown_remaining=$(printf '%s' "$_wdata" | cut -f8)
    wc_reboots_this_hour=$(printf '%s' "$_wdata" | cut -f9)
}

read_sim_state() {
    # SIM swap visibility — source of truth is now the persistent
    # /etc/qmanager/sim_registry.json record for the CURRENT ICCID, not the
    # root-owned /tmp/qmanager_sim_swap_detected flag's mere existence.
    # www-data cannot write that /tmp file (root-owned), so dismissal only
    # ever worked via browser localStorage before the registry existed.
    #
    # detected = a registry record exists for boot_iccid AND it has a
    # first_seen (i.e. it was actually created by a "new SIM" detection, not
    # just auto-vivified by a carrier/phone refresh backfill on an
    # already-known SIM) AND dismissed == false.
    #
    # The emitted sim_swap object SHAPE is unchanged (detected,
    # matching_profile_id, matching_profile_name) — the frontend type depends
    # on it. matching_profile_id/name are NOT part of the registry contract
    # (they're a one-shot detection-time artifact, not a per-ICCID durable
    # fact), so they still come from the /tmp flag, read only while a swap is
    # actively flagged as detected. The /tmp flag itself is still WRITTEN at
    # detection time (collect_boot_data) because monitoring/watchdog.sh's GET
    # handler and system/known_sims.sh's "clear" action both still read/clear
    # it independently — but it is no longer the gate for visibility here.
    sim_swap_detected="false"
    sim_swap_profile_id=""
    sim_swap_profile_name=""

    local _sim_norm_iccid
    _sim_norm_iccid=$(sim_db_normalize "$boot_iccid")

    if [ -n "$_sim_norm_iccid" ] && [ -f "$SIM_REGISTRY_FILE" ]; then
        local _reg_data _reg_first_seen _reg_dismissed
        _reg_data=$(jq -r --arg k "$_sim_norm_iccid" '
            (.[$k] // {}) as $r
            | [
                (($r.first_seen // "") | tostring),
                (($r.dismissed // false) | tostring)
              ] | @tsv
        ' "$SIM_REGISTRY_FILE" 2>/dev/null)
        _reg_first_seen=$(printf '%s' "$_reg_data" | cut -f1)
        _reg_dismissed=$(printf '%s' "$_reg_data" | cut -f2)
        if [ -n "$_reg_first_seen" ] && [ "$_reg_dismissed" != "true" ]; then
            sim_swap_detected="true"
        fi
    fi

    if [ "$sim_swap_detected" = "true" ] && [ -f "$SIM_SWAP_FLAG" ]; then
        local _swap_data
        _swap_data=$(jq -r '[
            (.matching_profile_id // ""),
            (.matching_profile_name // "")
        ] | @tsv' "$SIM_SWAP_FLAG" 2>/dev/null)
        sim_swap_profile_id=$(printf '%s' "$_swap_data" | cut -f1)
        sim_swap_profile_name=$(printf '%s' "$_swap_data" | cut -f2)
    fi

    # SIM failover state (written by watchcat Tier 3)
    sim_fo_active="false"
    sim_fo_original_slot="null"
    sim_fo_current_slot="null"
    sim_fo_switched_at="null"
    if [ -f "$SIM_FAILOVER_FILE" ]; then
        local _fo_data
        _fo_data=$(jq -r '[
            ((.active) | if . == null then "false" else tostring end),
            ((.original_slot) | if . == null then "null" else tostring end),
            ((.current_slot) | if . == null then "null" else tostring end),
            ((.switched_at) | if . == null then "null" else tostring end)
        ] | @tsv' "$SIM_FAILOVER_FILE" 2>/dev/null)
        sim_fo_active=$(printf '%s' "$_fo_data" | cut -f1)
        sim_fo_original_slot=$(printf '%s' "$_fo_data" | cut -f2)
        sim_fo_current_slot=$(printf '%s' "$_fo_data" | cut -f3)
        sim_fo_switched_at=$(printf '%s' "$_fo_data" | cut -f4)
    fi
}

# =============================================================================
# JSON CACHE WRITER
# =============================================================================

write_cache() {
    local timestamp
    timestamp=$(date +%s)

    # Build errors array
    local errors_json="[]"
    if [ -n "$errors" ]; then
        errors_json=$(jq -n --arg e "$errors" '[$e]')
    fi

    jq -n \
        --argjson timestamp "$timestamp" \
        --arg system_state "$system_state" \
        --argjson modem_reachable "$modem_reachable" \
        --argjson errors "$errors_json" \
        --argjson cfun "${t1_cfun:-1}" \
        --arg net_type "${network_type:-}" \
        --argjson sim_slot "${t2_sim_slot:-1}" \
        --arg carrier "$t2_carrier" \
        --arg service_status "$service_status" \
        --argjson ca_active "$t2_ca_active" \
        --argjson ca_count "$t2_ca_count" \
        --argjson nr_ca_active "$t2_nr_ca_active" \
        --argjson nr_ca_count "$t2_nr_ca_count" \
        --argjson total_bw "${t2_total_bandwidth_mhz:-0}" \
        --arg bw_details "$t2_bandwidth_details" \
        --argjson cc "$t2_carrier_components" \
        --arg apn "$t2_apn" \
        --arg wan4 "$t2_wan_ipv4" \
        --arg wan6 "$t2_wan_ipv6" \
        --arg dns1 "$t2_primary_dns" \
        --arg dns2 "$t2_secondary_dns" \
        --arg lte_st "$lte_state" \
        --arg lte_b "$lte_band" \
        --argjson lte_earfcn "${lte_earfcn:-null}" \
        --argjson lte_bw "${lte_bandwidth:-null}" \
        --argjson lte_pci "${lte_pci:-null}" \
        --argjson lte_cid "${lte_cell_id:-null}" \
        --argjson lte_enb "${lte_enodeb_id:-null}" \
        --argjson lte_sec "${lte_sector_id:-null}" \
        --argjson lte_tac "${lte_tac:-null}" \
        --argjson lte_rsrp "${lte_rsrp:-null}" \
        --argjson lte_rsrq "${lte_rsrq:-null}" \
        --argjson lte_sinr "${lte_sinr:-null}" \
        --argjson lte_rssi "${lte_rssi:-null}" \
        --argjson lte_ta "${lte_ta:-null}" \
        --arg nr_st "$nr_state" \
        --arg nr_b "$nr_band" \
        --argjson nr_arfcn "${nr_arfcn:-null}" \
        --argjson nr_pci "${nr_pci:-null}" \
        --argjson nr_cid "${nr_cell_id:-null}" \
        --argjson nr_enb "${nr_enodeb_id:-null}" \
        --argjson nr_sec "${nr_sector_id:-null}" \
        --argjson nr_tac "${nr_tac:-null}" \
        --argjson nr_rsrp "${nr_rsrp:-null}" \
        --argjson nr_rsrq "${nr_rsrq:-null}" \
        --argjson nr_sinr "${nr_sinr:-null}" \
        --argjson nr_scs "${nr_scs:-null}" \
        --argjson nr_ta "${nr_ta:-null}" \
        --argjson slr "$sig_lte_rsrp" \
        --argjson slq "$sig_lte_rsrq" \
        --argjson sls "$sig_lte_sinr" \
        --argjson snr "$sig_nr_rsrp" \
        --argjson snq "$sig_nr_rsrq" \
        --argjson sns "$sig_nr_sinr" \
        --argjson temp "${t2_temperature:-null}" \
        --argjson cpu "${cpu_usage:-0}" \
        --argjson mem_used "${memory_used_mb:-0}" \
        --argjson mem_total "${memory_total_mb:-0}" \
        --argjson uptime "${uptime_seconds:-0}" \
        --argjson conn_up "${conn_uptime_seconds:-0}" \
        --arg firmware "$boot_firmware" \
        --arg build_date "$boot_build_date" \
        --arg mfr "$boot_manufacturer" \
        --arg model "$boot_model" \
        --arg imei "$boot_imei" \
        --arg imsi "$boot_imsi" \
        --arg iccid "$boot_iccid" \
        --arg phone "$boot_phone_number" \
        --arg lte_cat "$boot_lte_category" \
        --arg mimo "$t2_mimo" \
        --arg sup_lte "$boot_supported_lte_bands" \
        --arg sup_nsa "$boot_supported_nsa_nr5g_bands" \
        --arg sup_sa "$boot_supported_sa_nr5g_bands" \
        --arg ippt_mode "$boot_ippt_mode" \
        --arg ippt_mac  "$boot_ippt_mac" \
        --arg ippt_nat  "$boot_ippt_nat" \
        --arg ippt_usb  "$boot_ippt_usbnet" \
        --arg ippt_dns  "$boot_ippt_dhcpv4dns" \
        --arg lan_ip    "$boot_lan_ip" \
        --arg lan_gw    "$boot_lan_gateway" \
        --argjson inet "${conn_internet_available:-null}" \
        --arg conn_st "$conn_status" \
        --argjson lat "${conn_latency:-null}" \
        --argjson avg_lat "${conn_avg_latency:-null}" \
        --argjson min_lat "${conn_min_latency:-null}" \
        --argjson max_lat "${conn_max_latency:-null}" \
        --argjson jit "${conn_jitter:-null}" \
        --argjson pkt_loss "${conn_packet_loss:-null}" \
        --arg ping_tgt "$conn_ping_target" \
        --argjson lat_hist "${conn_history:-[]}" \
        --argjson hist_int "${conn_history_interval:-2}" \
        --argjson hist_size "${CONN_HISTORY_SIZE:-60}" \
        --argjson during_rec "${conn_during_recovery:-false}" \
        --argjson thr_lat "${CQ_LAT_MS:-250}" \
        --argjson thr_loss "${CQ_LOSS_PCT:-30}" \
        --arg conn_profile "$conn_profile" \
        --arg conn_last_family "$conn_last_family" \
        --argjson dns_ms "${dns_lookup_ms:-null}" \
        --arg dns_res "$dns_resolver" \
        --argjson wc_enabled "${wc_enabled:-false}" \
        --arg wc_state "${wc_state:-disabled}" \
        --argjson wc_tier "${wc_current_tier:-0}" \
        --argjson wc_failures "${wc_failure_count:-0}" \
        --argjson wc_last_time "${wc_last_recovery_time:-null}" \
        --argjson wc_last_tier "${wc_last_recovery_tier:-null}" \
        --argjson wc_total "${wc_total_recoveries:-0}" \
        --argjson wc_cooldown "${wc_cooldown_remaining:-0}" \
        --argjson wc_reboots "${wc_reboots_this_hour:-0}" \
        --arg sim_status "${t2_sim_status:-unknown}" \
        --argjson sim_inserted "${t2_sim_inserted:-null}" \
        --argjson sf_active "${sim_fo_active:-false}" \
        --argjson sf_orig "${sim_fo_original_slot:-null}" \
        --argjson sf_curr "${sim_fo_current_slot:-null}" \
        --argjson sf_time "${sim_fo_switched_at:-null}" \
        --argjson ss_detected "${sim_swap_detected:-false}" \
        --arg ss_profile_id "$sim_swap_profile_id" \
        --arg ss_profile_name "$sim_swap_profile_name" \
        --arg     sh_state          "$sh_state" \
        --arg     sh_state_raw      "$sh_state_raw" \
        --argjson sh_crash_count    "${sh_crash_count:-null}" \
        --argjson sh_coredump       "${sh_coredump_present:-false}" \
        --argjson sh_last_crash_at  "${sh_last_crash_at:-null}" \
        --argjson sh_total_crashes  "${sh_total_logged_crashes:-0}" \
        --argjson sh_load_1m        "${sh_load_1m:-null}" \
        --argjson sh_load_5m        "${sh_load_5m:-null}" \
        --argjson sh_load_15m       "${sh_load_15m:-null}" \
        --argjson sh_core_count     "${sh_core_count:-null}" \
        --argjson sh_freq_khz       "${sh_freq_khz:-null}" \
        --argjson sh_max_freq_khz   "${sh_max_freq_khz:-null}" \
        --argjson sh_st_total_kb    "${sh_storage_total_kb:-null}" \
        --argjson sh_st_used_kb     "${sh_storage_used_kb:-null}" \
        --argjson sh_st_avail_kb    "${sh_storage_avail_kb:-null}" \
        --argjson du_acc_rx    "${du_accumulated_rx:-0}" \
        --argjson du_acc_tx    "${du_accumulated_tx:-0}" \
        --arg     du_sel       "${du_selected_counter:-}" \
        --argjson du_last_upd  "${du_last_update_ts:-0}" \
        --argjson du_last_rst  "${du_last_reset_ts:-0}" \
        --argjson du_modem_rst "${du_modem_reset_count:-0}" \
        --arg     du_orient    "${orientation:-normal}" \
        --argjson phy          "${phy_json:-null}" \
        '{
            timestamp: $timestamp,
            system_state: $system_state,
            modem_reachable: $modem_reachable,
            last_successful_poll: $timestamp,
            errors: $errors,
            network: {
                cfun: $cfun,
                type: $net_type,
                sim_slot: $sim_slot,
                carrier: $carrier,
                service_status: $service_status,
                ca_active: $ca_active,
                ca_count: $ca_count,
                nr_ca_active: $nr_ca_active,
                nr_ca_count: $nr_ca_count,
                total_bandwidth_mhz: $total_bw,
                bandwidth_details: $bw_details,
                carrier_components: $cc,
                apn: $apn,
                wan_ipv4: $wan4,
                wan_ipv6: $wan6,
                primary_dns: $dns1,
                secondary_dns: $dns2,
                device_ip: $lan_ip,
                lan_gateway: $lan_gw
            },
            lte: {
                state: $lte_st, band: $lte_b,
                earfcn: $lte_earfcn, bandwidth: $lte_bw,
                pci: $lte_pci, cell_id: $lte_cid,
                enodeb_id: $lte_enb, sector_id: $lte_sec, tac: $lte_tac,
                rsrp: $lte_rsrp, rsrq: $lte_rsrq,
                sinr: $lte_sinr, rssi: $lte_rssi, ta: $lte_ta
            },
            nr: {
                state: $nr_st, band: $nr_b,
                arfcn: $nr_arfcn, pci: $nr_pci,
                cell_id: $nr_cid, enodeb_id: $nr_enb,
                sector_id: $nr_sec, tac: $nr_tac,
                rsrp: $nr_rsrp, rsrq: $nr_rsrq,
                sinr: $nr_sinr, scs: $nr_scs, ta: $nr_ta
            },
            signal_per_antenna: {
                lte_rsrp: $slr, lte_rsrq: $slq, lte_sinr: $sls,
                nr_rsrp: $snr, nr_rsrq: $snq, nr_sinr: $sns
            },
            device: {
                temperature: $temp, cpu_usage: $cpu,
                memory_used_mb: $mem_used, memory_total_mb: $mem_total,
                uptime_seconds: $uptime, conn_uptime_seconds: $conn_up,
                firmware: $firmware, build_date: $build_date,
                manufacturer: $mfr, model: $model,
                imei: $imei, imsi: $imsi,
                iccid: $iccid, phone_number: $phone,
                lte_category: $lte_cat, mimo: $mimo,
                supported_lte_bands: $sup_lte,
                supported_nsa_nr5g_bands: $sup_nsa,
                supported_sa_nr5g_bands: $sup_sa,
                ippt_mode: $ippt_mode,
                ippt_mac: $ippt_mac,
                ippt_nat: $ippt_nat,
                ippt_usbnet: $ippt_usb,
                ippt_dhcpv4dns: $ippt_dns
            },
            data_used: {
                accumulated_rx_bytes: $du_acc_rx,
                accumulated_tx_bytes: $du_acc_tx,
                selected_counter:     $du_sel,
                last_update_ts:       $du_last_upd,
                last_reset_ts:        $du_last_rst,
                modem_reset_count:    $du_modem_rst,
                orientation:          $du_orient
            },
            connectivity: {
                internet_available: $inet, status: $conn_st,
                latency_ms: $lat, avg_latency_ms: $avg_lat,
                min_latency_ms: $min_lat, max_latency_ms: $max_lat,
                jitter_ms: $jit, packet_loss_pct: $pkt_loss,
                ping_target: $ping_tgt, latency_history: $lat_hist,
                history_interval_sec: $hist_int, history_size: $hist_size,
                during_recovery: $during_rec,
                thresholds: {latency_ms: $thr_lat, loss_pct: $thr_loss},
                profile: $conn_profile,
                dns_lookup_ms: $dns_ms,
                dns_resolver: (if $dns_res == "" then null else $dns_res end),
                last_family: (if $conn_last_family == "null" then null else $conn_last_family end)
            },
            watchcat: {
                enabled: $wc_enabled, state: $wc_state,
                current_tier: $wc_tier, failure_count: $wc_failures,
                last_recovery_time: $wc_last_time,
                last_recovery_tier: $wc_last_tier,
                total_recoveries: $wc_total,
                cooldown_remaining: $wc_cooldown,
                reboots_this_hour: $wc_reboots
            },
            sim: {
                status: $sim_status,
                inserted: $sim_inserted
            },
            sim_failover: {
                active: $sf_active,
                original_slot: $sf_orig,
                current_slot: $sf_curr,
                switched_at: $sf_time
            },
            sim_swap: {
                detected: $ss_detected,
                matching_profile_id: $ss_profile_id,
                matching_profile_name: $ss_profile_name
            },
            system_health: {
                state:                $sh_state,
                state_raw:            (if $sh_state_raw == "" then null else $sh_state_raw end),
                crash_count:          $sh_crash_count,
                coredump_present:     $sh_coredump,
                last_crash_at:        $sh_last_crash_at,
                total_logged_crashes: $sh_total_crashes,
                cpu: {
                    load_1m:      $sh_load_1m,
                    load_5m:      $sh_load_5m,
                    load_15m:     $sh_load_15m,
                    core_count:   $sh_core_count,
                    usage_pct:    $cpu,
                    freq_khz:     $sh_freq_khz,
                    max_freq_khz: $sh_max_freq_khz
                },
                memory: (
                    if $mem_total > 0 then
                        { total_kb: ($mem_total * 1024),
                          used_kb:  ($mem_used * 1024),
                          available_kb: (($mem_total - $mem_used) * 1024) }
                    else null end
                ),
                storage: (
                    if $sh_st_total_kb == null then null else
                        { mount: "/usrdata",
                          total_kb: $sh_st_total_kb,
                          used_kb:  $sh_st_used_kb,
                          available_kb: $sh_st_avail_kb }
                    end
                )
            }
        } + (if $phy == null then {} else {phy: $phy} end)' > "$CACHE_TMP"

    mv "$CACHE_TMP" "$CACHE_FILE"
}

# =============================================================================
# NEIGHBOUR LIVE VIEW (QMI)
# =============================================================================
# Antenna aiming needs a neighbour list that updates while the antenna moves.
# The AT scanner cannot do that (two commands plus a hard sleep 1, 3-6 s, on the
# contended AT port), so the live view reads QMI instead — a different pipe into
# the modem that no AT consumer can starve (docs/reference/qmi-transport.md).
#
# The browser holds a LEASE, exactly as the sites monitor does: while
# /tmp/qmanager_neighbours_live holds an epoch 0-10 s old, this daemon ticks;
# when the tab closes and the renewals stop, the lease goes stale on its own and
# the cost drops to one `[ -f ]` per cycle. There is no "live mode" flag to
# leave switched on, and nothing here writes the lease.

# True while the lease holds a recent epoch. The file belongs to www-data, so
# nothing in it is trusted beyond digits: not a symlink, at most 12 characters,
# and the age must be in the future-tolerant 0..LIVE_LEASE_SEC window.
neighbours_live_fresh() {
    local v="" now
    [ -f "$NEIGHBOURS_LIVE_LEASE" ] && [ ! -L "$NEIGHBOURS_LIVE_LEASE" ] || return 1
    v=$(cat "$NEIGHBOURS_LIVE_LEASE" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#v}" -le 12 ] || return 1
    now=$(date +%s)
    [ $(( now - 10#$v )) -ge 0 ] && [ $(( now - 10#$v )) -le "$NEIGHBOURS_LIVE_LEASE_SEC" ]
}

# Warn at most once per NEIGHBOURS_LIVE_WARN_GAP. A failing live read repeats
# every cycle (~4 s), and one line per tick would bury the log in ~900 lines an
# hour for a view nobody may even be watching.
neighbours_live_warn() {
    local now
    now=$(date +%s)
    [ $(( now - neigh_live_warn_at )) -ge "$NEIGHBOURS_LIVE_WARN_GAP" ] || return 0
    neigh_live_warn_at=$now
    qlog_warn "neighbours live: $1"
}

# One live tick: one neighbours read + one signal read, merged into one object
# and published atomically. Returns non-zero without touching the previous file
# when either read fails — a stale-but-labelled sample is recoverable, a file
# half-overwritten by a failed tick is not.
#
# The explicit qm_qmi_available call is not redundant: it caches the capability
# in THIS shell, and the two command substitutions below inherit it, so the tick
# pays for one capability probe rather than three (qmi_read.sh's cache cannot
# travel back out of a subshell — see its header).
#
# sinr is joined onto `serving` from the signal read because the neighbours call
# does not report it; every other serving field comes from the serving cell's own
# row in the neighbours answer, so Δ-RSRP against the table below it is exact.
neighbours_live_tick() {
    local cells sig out at rc tmp
    qm_qmi_available || { neighbours_live_warn "QMI unavailable — live view idle"; return 1; }

    cells=$(qm_qmi_neighbours)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        neighbours_live_warn "neighbour read failed (qmi status ${rc})"
        return 1
    fi

    sig=$(qm_qmi_signal)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        neighbours_live_warn "signal read failed (qmi status ${rc})"
        return 1
    fi

    at=$(date +%s)
    out=$(jq -c -n --argjson at "$at" --argjson n "$cells" --argjson s "$sig" '
        {at: $at,
         registered: ($s.registered == true),
         carrier: (if ($s.carrier | type) == "string" then $s.carrier else null end),
         serving: (if ($n.serving | type) == "object"
                   then $n.serving + {sinr: (if ($s.lte.snr | type) == "number" then $s.lte.snr else null end)}
                   else null end),
         cells: (if ($n.cells | type) == "array" then $n.cells else [] end)}' 2>/dev/null)
    if [ -z "$out" ]; then
        neighbours_live_warn "jq merge produced nothing"
        return 1
    fi

    # Atomic publish: mktemp in /tmp (same filesystem as the target, so the mv
    # is a rename), fully written and chmodded before it replaces the old file.
    # A reader therefore sees either the previous sample or this one, never a
    # partial object — the CGI's 6 s freshness window is judged on `at` alone.
    tmp=$(mktemp "${NEIGHBOURS_LIVE_FILE}.XXXXXX" 2>/dev/null) || {
        neighbours_live_warn "mktemp failed"
        return 1
    }
    if printf '%s\n' "$out" > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$NEIGHBOURS_LIVE_FILE"; then
        return 0
    fi
    rm -f "$tmp"
    neighbours_live_warn "could not publish $NEIGHBOURS_LIVE_FILE"
    return 1
}

# Lease gate + the on/off transition line. Called once per cycle from main.
neighbours_live_service() {
    if neighbours_live_fresh; then
        if [ "$neigh_live_on" != "true" ]; then
            neigh_live_on=true
            qlog_info "neighbours: live mode on"
        fi
        neighbours_live_tick
    elif [ "$neigh_live_on" = "true" ]; then
        neigh_live_on=false
        qlog_info "neighbours: live mode off"
    fi
    return 0
}

# =============================================================================
# POLL CYCLE
# =============================================================================

poll_cycle() {
    # --- LONG_FLAG expiry guard ---
    # If a CGI sets the flag and dies before clearing it, the poller would
    # otherwise stay in scan_in_progress mode forever. Treat any flag older
    # than LONG_FLAG_MAX_AGE seconds as stale and remove it.
    if [ -f "$LONG_FLAG" ]; then
        local _lf_mtime _lf_now _lf_age
        _lf_mtime=$(stat -c %Y "$LONG_FLAG" 2>/dev/null || echo 0)
        _lf_now=$(date +%s)
        _lf_age=$((_lf_now - _lf_mtime))
        if [ "$_lf_age" -gt "$LONG_FLAG_MAX_AGE" ] 2>/dev/null; then
            qlog_warn "LONG_FLAG stale (age=${_lf_age}s > ${LONG_FLAG_MAX_AGE}s) — removing"
            rm -f "$LONG_FLAG"
        fi
    fi
    # --- end LONG_FLAG expiry guard ---

    # --- Ping-based checks FIRST (no modem dependency) ---
    # These must run before AT commands in case qcmd blocks on serial I/O.
    update_proc_metrics
    update_system_health
    read_ping_data
    read_dns_data
    detect_data_connection_events
    check_alerts

    if [ -f "$LONG_FLAG" ]; then
        if [ "$system_state" != "scan_in_progress" ]; then
            qlog_state_change "system_state" "$system_state" "scan_in_progress"
        fi
        system_state="scan_in_progress"
        # Ping history (every Tier 1.5 interval — 10s)
        if [ $((cycle_count % TIER1_5_EVERY)) -eq 0 ]; then
            append_ping_history
        fi
        update_conn_uptime
        write_cache
        return
    fi

    errors=""
    system_state="normal"

    # Tier 1 (AT — may block if modem is unresponsive): serving cell + CA in
    # one compound; see poll_tier1_at for the fallback rules.
    poll_tier1_at
    sleep "$SIP_DELAY"

    # Tier 1 — modem crash watcher (pure sysfs reads; no-op when disabled)
    crash_watcher_check

    # Persistent Data Used counter (Tier 1) — network_type is set by
    # poll_serving_cell above; must run before write_cache below.
    update_data_used

    # Tier 1.5 (per-antenna signal history + watchcat state)
    if [ $((cycle_count % TIER1_5_EVERY)) -eq 0 ]; then
        poll_per_antenna_signal
        sleep "$SIP_DELAY"
        read_watchcat_state
    fi

    # Tier 2 (warm data + SIM state + CFUN)
    # Honor the on-demand refresh flag so a SIM-slot change picks up the
    # new carrier name within ~2s instead of up to ~30s.
    force_tier2=false
    if [ -f "$TIER2_REFRESH_FLAG" ]; then
        force_tier2=true
        rm -f "$TIER2_REFRESH_FLAG"
    fi
    if [ "$force_tier2" = "true" ] || [ $((cycle_count % TIER2_EVERY)) -eq 0 ]; then
        poll_tier2
        read_sim_state
        [ "$force_tier2" = "true" ] && read_sim_identity

        # CFUN — standalone query (compound commands timeout in CFUN=0).
        # Cadence is Tier 2 because airplane-mode toggles are user-driven and rare.
        local cfun_result
        cfun_result=$(qcmd 'AT+CFUN?' 2>/dev/null)
        if [ -n "$cfun_result" ]; then
            local cfun_val
            cfun_val=$(printf '%s\n' "$cfun_result" | grep '+CFUN:' | head -1 | tr -d '\r' | awk -F': ' '{print $2}' | tr -d ' ')
            [ -n "$cfun_val" ] && t1_cfun="$cfun_val"
        fi
        sleep "$SIP_DELAY"
    fi

    # Ping history (every Tier 1.5 interval — 10s)
    if [ $((cycle_count % TIER1_5_EVERY)) -eq 0 ]; then
        append_ping_history
    fi
    update_conn_uptime
    determine_service_status
    detect_events
    write_cache

    cycle_count=$((cycle_count + 1))
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local cycle_start cycle_end cycle_duration

    qlog_info "========================================"
    qlog_info "QManager Poller starting"
    qlog_info "Config: interval=${POLL_INTERVAL}s tier2_every=${TIER2_EVERY} iface=${NETWORK_IFACE}"
    qlog_info "Log level: ${QLOG_LEVEL:-INFO}"
    qlog_info "========================================"

    # Resolve counter orientation from SoC once at startup.
    orientation=$(detect_orientation_from_soc)
    if [ "$orientation" = "reversed" ]; then
        orientation_dl_field=10
        orientation_ul_field=2
    else
        orientation_dl_field=2
        orientation_ul_field=10
    fi
    qlog_info "data_used: counter orientation = ${orientation} (DL=field${orientation_dl_field}, UL=field${orientation_ul_field})"

    collect_boot_data
    update_proc_metrics
    update_system_health
    cq_thresholds_refresh
    alert_engine_init
    restore_event_state
    crash_watcher_init
    write_cache

    _bt_cs
    qlog_info "Boot data collected, entering poll loop (first status published at kernel uptime $(( _BT_NOW / 100 ))s)"

    # Cycle timing from /proc/uptime (builtin read, monotonic) instead of two
    # `date +%s` forks per cycle (37 ms/cycle on the RG520N-EB, 2026-10-22). It
    # only feeds the budget warning, so whole seconds are enough, and uptime
    # cannot jump the way the wall clock does before NTP sync.
    local _up _upr _cs0 _cs1 _rem
    while true; do
        read -r _up _upr < /proc/uptime; cycle_start=${_up%%.*}
        _cs0=$(( ${_up%%.*} * 100 + 10#${_up#*.} ))
        poll_cycle
        read -r _up _upr < /proc/uptime; cycle_end=${_up%%.*}
        cycle_duration=$((cycle_end - cycle_start))
        if [ "$cycle_duration" -gt "$CYCLE_TIME_BUDGET" ]; then
            qlog_warn "poll_cycle exceeded budget: ${cycle_duration}s > ${CYCLE_TIME_BUDGET}s"
        fi
        # Tier 3 — PHY depth (~60s), deliberately AFTER cycle_end for the same
        # reason as the neighbour live tick below: it is the one block that holds
        # the AT lock for ~1.2s by itself, and the budget warning has to keep
        # meaning Tier-1/AT slowness. `LONG_FLAG` (a scan holding the port) is
        # checked inside poll_tier3, so a scan cycle skips it entirely.
        if [ "$cycle_count" -gt 0 ] && [ $((cycle_count % TIER3_EVERY)) -eq 0 ]; then
            poll_tier3
        fi

        # Neighbour live tick — deliberately AFTER cycle_end, not inside the
        # cycle body: it is the one thing here that can block on something other
        # than the AT port, and running it past the budget timer keeps
        # `poll_cycle exceeded budget` meaning exactly what it meant before this
        # feature (AT/Tier-1 slowness) instead of also firing on a slow QMI read.
        # No lease => one `[ -f ]` test and nothing else, which is why the
        # no-lease path stays byte-identical to the pre-feature poller.
        neighbours_live_service

        # Live aim view: keep the old short gap — its CGI judges freshness on a
        # 6 s window, and a lease means someone is watching right now.
        if [ "$neigh_live_on" = "true" ]; then
            sleep "$POLL_INTERVAL"
            continue
        fi
        read -r _up _upr < /proc/uptime
        _cs1=$(( ${_up%%.*} * 100 + 10#${_up#*.} ))
        _rem=$(( POLL_PERIOD * 100 - (_cs1 - _cs0) ))
        [ "$_rem" -lt $(( POLL_INTERVAL * 100 )) ] && _rem=$(( POLL_INTERVAL * 100 ))
        if [ $(( _rem % 100 )) -lt 10 ]; then
            sleep "$(( _rem / 100 )).0$(( _rem % 100 ))"
        else
            sleep "$(( _rem / 100 )).$(( _rem % 100 ))"
        fi
    done
}

main "$@"
