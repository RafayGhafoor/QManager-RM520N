# /etc/systemd/system/qmanager-scenario-schedule.service
#
# Deploy-layer copy of scripts/etc/systemd/system/qmanager-scenario-schedule.service,
# ExecStart repointed at /usrdata/qmanager/bin. Same defect class as the
# tower-schedule pair: qmanager_scenario_schedule_arm returns
# {"armed":false,"reason":"unit_absent"} unless this file exists, so a saved
# Connection Scenario schedule could never fire.
[Unit]
Description=QManager scenario schedule apply (triggered by qmanager-scenario-schedule.timer)

[Service]
Type=oneshot
# PATH is load-bearing: the workers read the saved schedule with `jq`, and
# systemd's default PATH has neither our bin dir nor /usr/sbin — measured
# 2026-10-25, `env -i sh -c 'command -v jq'` finds nothing, so the fire guard
# read an empty schedule and skipped EVERY fire ("schedule time
# unreadable/invalid"). Same trap deploy/qmanager-poller.service documents.
Environment=PATH=/usrdata/qmanager/bin:/usr/bin:/bin:/sbin:/usr/sbin
ExecStart=/usrdata/qmanager/bin/qmanager_scenario_schedule --now

# No [Install] section — this unit is only ever started by
# qmanager-scenario-schedule.timer, never boot-enabled directly. That .timer
# is generated and armed at runtime by qmanager_scenario_schedule_arm whenever
# a profile with an enabled scenario schedule becomes active.
