#!/bin/sh
# =============================================================================
# atcli_smd11 — compatibility shim for QManager on GreenPacket RG520N-EB
# =============================================================================
# QManager's qcmd expects a binary named atcli_smd11 that:
#   * takes one AT command as $1,
#   * writes the raw response text to stdout,
#   * ALWAYS exits 0 (qcmd does its own OK/ERROR text parsing).
#
# This firmware does NOT ship atcli_smd11, and /dev/smd11 is owned by modemd
# (its AT multiplexer). Two working ports exist here:
#   /dev/smd7    — the vendor's "spare" AT port, but the vendor's own metricsd
#                  polls it every ~0.4s and STEALS response bytes: without the
#                  shared atlock, responses get truncated to a bare "OK".
#   /dev/at_mdm0 — the modem's dedicated AT channel (bridged to the USB AT
#                  port by port_bridge). Measured clean and complete on every
#                  call, with no participation in the vendor's atlock.
# We default to at_mdm0 so QManager never contends with the vendor metrics
# daemon. Set AT_DEV=/dev/smd7 to use the spare port instead (it then waits on
# the vendor atlock, but does not hold it).
#
# The capture technique below is copied from the vendor's proven at_smd()
# (/data/gp/gp-qmi.sh) — the port is a raw char device, not a tty:
#   * background raw reader into a temp file (no termios/stty/read -t),
#   * write the command + CR via `printf | dd` (not shell redirection; see below),
#   * poll the capture file until OK / ERROR / +CME ERROR, or a budget expires,
#   * kill the reader and dump whatever landed.
#
# We deliberately do NOT create the vendor's atlock dir /tmp/gp-radio.lock —
# only observe it — so we never corrupt the vendor's stale-lock protocol.
# QManager's own serialization happens upstream in qcmd (/tmp/qmanager_at.lock).
#
# Exit status is always 0. Override the port with AT_DEV=... if ever needed.
# =============================================================================

AT_DEV="${AT_DEV:-/dev/at_mdm0}"
GP_ATLOCK="${GP_ATLOCK:-/tmp/gp-radio.lock}"

CMD="$1"
[ -n "$CMD" ] || exit 0
[ -c "$AT_DEV" ] || exit 0

# Long commands (cell scan, FOTA) get a much larger budget than ordinary ones.
case "$CMD" in
    *QSCAN*|*QSCANFREQ*|*QFOTADL*) TICKS=240 ;;   # ~60s
    *)                            TICKS=48  ;;   # ~12s
esac

# --- Respect vendor radio activity (best effort, never block a CGI for long) --
# If the vendor holds the atlock (CFUN cycle, band change, metrics refresh),
# give it a brief window to finish. Proceed regardless after that.
i=0
while [ -d "$GP_ATLOCK" ] && [ "$i" -lt 10 ]; do
    sleep 0.5
    i=$((i + 1))
done

# --- Drain stale bytes left by the PREVIOUS invocation -----------------------
# We kill the reader the moment OK appears, so whatever the modem emitted after
# that (the trailing CRLF, a late ERROR, a queued URC) stays in the device buffer
# and is the FIRST thing the next invocation's reader sees. Measured effect:
#   AT+QTEMP    -> "+CFUN: 1", "OK", "ERROR"     (all stale, then its own ERROR)
#   AT+QENG=... -> "ERROR" then the real +QENG lines
# Parsers then read the wrong line, which is how "missing information" shows up
# in the UI. Drain to /dev/null first so every capture starts on a clean slate.
#
# Process budget: on this SoC a fork+exec costs ~3 ms of CPU however little the
# program does (docs/reference/poller-cpu-profile.md), and this shim runs once
# per AT command for the poller AND every CGI. So: the drain goes straight to
# /dev/null (no temp file to rm), the terminator poll and the final cleanup use
# shell builtins instead of grep / sed. Only dd, sleep and one tr remain.

# One clean send + capture round. Leaves the raw text in $OUT.
# Returns 2 when the modem produced NO BYTES AT ALL (a dropped command), 0 otherwise.
capture_once() {
    # Drain to /dev/null first (see the note above about stale bytes).
    # `dd` performs the raw drain without probing termios. Keep the reader
    # backgrounded: replies arrive asynchronously and this is how the modem
    # channel is captured. (The measured ioctl trigger was the paired shell
    # printf-redirection writer below, not opening/reading the node by itself.)
    dd if="$AT_DEV" of=/dev/null bs=4096 2>/dev/null &
    _dp=$!
    sleep 0.15
    kill "$_dp" 2>/dev/null
    wait "$_dp" 2>/dev/null
    : > "$OUT"     # builtin truncate (was rm -f): [ -s ] below must start false

    # Same raw reader as the stale-byte drain above. Do not use head/grep/wc
    # directly on the node: these tools probe termios on this BusyBox build.
    # bs=4096, NOT 256: at_mdm0 is a packet device, and a read() shorter than
    # the packet discards the rest. At bs=256 AT+CGCONTRDP (~290 B) arrived cut
    # at 254 B with no OK, so every call burned the full 12 s budget (measured
    # 2026-10-22; platform-matrix.md, "PACKET device").
    dd if="$AT_DEV" of="$OUT" bs=4096 2>/dev/null &
    RPID=$!
    sleep 0.12

    # Do not use shell redirection to write the device while a reader is open:
    # the paired `printf > glink_pkt` transaction emits one TCGETS/0x5401
    # ioctl warning per command (even though the script has no explicit
    # stty/ioctl). Send the same bytes through dd instead. Verified on RG520N-EB:
    # reader + printf>|device -> +1 dmesg line; reader + printf|dd of=device ->
    # 0. The read-before-reply ordering remains unchanged; see platform-matrix.md.
    if ! printf '%s\r' "$CMD" | dd of="$AT_DEV" bs=1 2>/dev/null; then
        kill "$RPID" 2>/dev/null
        wait "$RPID" 2>/dev/null
        return 1
    fi

    # Phase 1 — did the modem answer AT ALL? A dropped command produces zero
    # bytes, so it is detected in ~1.5s instead of burning the full budget.
    # That matters: the caller retries this, and a retry that waited the whole
    # 12s budget would hold the AT flock (qcmd's lock) for ~36s and starve
    # every CGI request behind it.
    i=0
    while [ "$i" -lt 6 ]; do
        [ -s "$OUT" ] && break
        sleep 0.25
        i=$((i + 1))
    done

    if [ ! -s "$OUT" ]; then
        kill "$RPID" 2>/dev/null
        wait "$RPID" 2>/dev/null
        return 2
    fi

    # Phase 2 — wait for a terminator.
    i=0
    while [ "$i" -lt "$TICKS" ]; do
        has_terminator && break
        sleep 0.25
        i=$((i + 1))
    done

    kill "$RPID" 2>/dev/null
    wait "$RPID" 2>/dev/null
    return 0
}

# Builtin equivalent of
#   grep -q -e '^OK' -e '^ERROR' -e '+CME ERROR' "$OUT"
# (line starts OK / starts ERROR / contains +CME ERROR; CRs are still on the
# lines, which OK* and ERROR* match exactly as the anchored grep did). The
# `|| [ -n ]` keeps an unterminated last line, which grep also matched.
has_terminator() {
    [ -s "$OUT" ] || return 1
    while IFS= read -r _l || [ -n "$_l" ]; do
        case "$_l" in
            OK*|ERROR*|*"+CME ERROR"*) return 0 ;;
        esac
    done < "$OUT"
    return 1
}

# --- Send + capture ----------------------------------------------------------
OUT="/tmp/atcli_smd11.$$"
trap 'rm -f "$OUT"' EXIT INT TERM

# The port intermittently answers NOTHING AT ALL. Measured: 4 of 5 identical
# AT+QNWPREFCFG reads came back with zero bytes while the modem was healthy and
# online. qcmd reports that as "command_failed", so the UI showed an empty
# Network Priority panel and an "at_failed" error on a working modem.
#
# A missing response does NOT prove a write had no side effect: the modem may
# have applied a setter and then dropped its reply. Only retry a narrow,
# explicitly read-only allowlist; generic/custom AT commands are never replayed.
# Anything non-empty is left alone, however broken, for qcmd to judge.
RETRY_EMPTY=false
case "$CMD" in
    *\?*|\
    AT+CGPADDR|AT+CGCONTRDP|AT+CGCONTRDP=*|AT+QCAINFO|AT+QENG=*|\
    'AT+QCAINFO=1;+QCAINFO;+QCAINFO=0'|\
    'AT+QENG="servingcell";+QCAINFO=1;+QCAINFO;+QCAINFO=0'|\
    'AT+CVERSION;+'*|'AT+QGETCAPABILITY'|\
    'AT+QNWPREFCFG="rat_acq_order"'|\
    'AT+QNWCFG="lte_mimo_layers"'|'AT+QNWCFG="nr5g_mimo_layers"'|\
    'AT+QNWCFG="lte_time_advance"'|'AT+QNWCFG="nr5g_time_advance"'|\
    'AT+QTEMP') RETRY_EMPTY=true ;;
esac

ATTEMPT=1
while :; do
    capture_once
    _cr=$?

    [ "$_cr" -eq 2 ] || break                   # answered (or write failed)
    [ "$RETRY_EMPTY" = "true" ] || break       # never replay arbitrary writes
    [ "$ATTEMPT" -ge 3 ] && break
    ATTEMPT=$((ATTEMPT + 1))
    sleep 0.2
done

# Strip CRs/NULs, then drop LEADING blank lines. The capture starts with an
# empty line (the port emits CRLF before the payload); upstream's binary does
# not, and several parsers slice line 1 (e.g. health-check's AT+CGMI test),
# which then read an empty string instead of "Quectel".
#
# Same result as `tr -d '\r\000' < OUT | sed -e '/./,$!d'`, minus the sed and
# the pipe: leading newlines are trimmed with parameter expansion. Trailing
# newlines collapse to one, which every caller's $(...) strips anyway.
_resp=$(tr -d '\r\000' < "$OUT" 2>/dev/null)
_nl='
'
while :; do
    case "$_resp" in
        "$_nl"*) _resp="${_resp#"$_nl"}" ;;
        *) break ;;
    esac
done
[ -n "$_resp" ] && printf '%s\n' "$_resp"

exit 0
