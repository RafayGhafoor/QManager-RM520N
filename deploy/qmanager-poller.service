[Unit]
Description=QManager Modem Data Poller
Documentation=https://github.com/RafayGhafoor/QManager-RM520N
StartLimitIntervalSec=3600
# 5 was too tight here: this device SIGTERMs services during memory-pressure
# and boot-cleanup sweeps, and once the limit is hit the poller stays parked in
# `failed` for the rest of the hour, which shows up as a permanently "inactive"
# poller in QManager's own health check. A daemon should keep coming back.
StartLimitBurst=20

[Service]
Type=simple
# QManager's helpers live on the writable ubifs volume, not /usr/bin (this
# device's rootfs is a read-only squashfs), so jq/qcmd must be on PATH.
Environment=PATH=/usrdata/qmanager/bin:/usr/bin:/bin:/sbin:/usr/sbin
# Wait for a REAL answer, not just the device node: the poller caches device
# identity once at start, and a modem that is still booting answers with the
# "RDY" URC, which was observed baking "model": "RDY" into the cache.
ExecStartPre=/usrdata/qmanager/bin/qm_wait_modem.sh 150
ExecStart=/usrdata/qmanager/bin/qmanager_poller
TimeoutStartSec=170
TimeoutStopSec=10
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
