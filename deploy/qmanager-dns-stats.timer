# /etc/systemd/system/qmanager-dns-stats.timer
#
# 5-minute cadence for the DNS stats sampler.
#
# Why 5 min: the page's shortest range is 1 h, which then has 12 points — enough
# for a readable rate line without inventing resolution. At 5 min the ring file
# holds 24 h in 288 rows (~35 kB on tmpfs).
#
# Why not 1 min: this device is a single-core SDX6X already running a 5 s poller
# and a 5 s ping loop. Each sample costs a SIGUSR1 + a syslog scan + a jq, and the
# rate metrics it feeds change on the scale of a browsing session, not a minute.
# Raise the sample rate only with a measured fork-rate before/after (AGENTS.md
# rule 1a) — the poller history is the precedent for how much that costs.
#
# RandomizedDelaySec avoids landing every 5 minutes on the same second as the
# vendor's gp-keepalive sweep, which saturates the uplink and would distort the
# latency half of the payload.

[Unit]
Description=Timer for the QManager DNS stats sampler

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30
AccuracySec=30s
Unit=qmanager-dns-stats.service

[Install]
WantedBy=timers.target
