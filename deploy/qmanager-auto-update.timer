# /etc/systemd/system/qmanager-auto-update.timer
#
# Deploy-layer copy of scripts/etc/systemd/system/qmanager-auto-update.timer.
# Content is unchanged from upstream (the ExecStart lives in the paired
# .service); it is shipped here so the Software Update toggle has something to
# arm. See qmanager-schedule-rearm.service for how it is brought up at boot on
# this firmware, where a symlink in timers.target.wants is not enough.
[Unit]
Description=QManager Unattended Update Check (daily)

[Timer]
# Fires once a day; RandomizedDelaySec spreads a whole fleet's GitHub API
# calls across a 3-hour window instead of everyone hitting api.github.com at
# once on the hour. Persistent=true catches a missed run (device was off /
# rebooting at the scheduled time) on the next boot instead of silently
# skipping a day.
#
# Persistent=true is intentional and is KEPT (not a bug): missed-day catch-up
# is genuinely wanted for a daily update check. It is only safe because
# qmanager_auto_update (the fired worker) carries the boot-window fire guard
# (_qm_timer_fire_allowed) — without that guard, this same catch-up mechanism
# fires at boot against a stepped clock on every boot (no battery RTC).
OnCalendar=daily
RandomizedDelaySec=3h
Persistent=true

[Install]
WantedBy=timers.target
