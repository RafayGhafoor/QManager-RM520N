# /etc/systemd/system/qmanager-scheduled-reboot.service
#
# Deploy-layer copy of scripts/etc/systemd/system/qmanager-scheduled-reboot.service,
# ExecStart repointed at /usrdata/qmanager/bin. Same reason as the tower-schedule
# pair: qmanager_scheduled_reboot_arm writes the .timer at runtime but will not
# arm it unless this .service exists, and this deployment never shipped it —
# Scheduled Reboot therefore saved and reported "unit_absent" instead of firing.
[Unit]
Description=QManager scheduled reboot (triggered by qmanager-scheduled-reboot.timer)

[Service]
Type=oneshot
# PATH is load-bearing: the workers read the saved schedule with `jq`, and
# systemd's default PATH has neither our bin dir nor /usr/sbin — measured
# 2026-10-25, `env -i sh -c 'command -v jq'` finds nothing, so the fire guard
# read an empty schedule and skipped EVERY fire ("schedule time
# unreadable/invalid"). Same trap deploy/qmanager-poller.service documents.
Environment=PATH=/usrdata/qmanager/bin:/usr/bin:/bin:/sbin:/usr/sbin
ExecStart=/usrdata/qmanager/bin/qmanager_scheduled_reboot

# No [Install] section — this unit is only ever started by
# qmanager-scheduled-reboot.timer, never boot-enabled directly. That .timer
# is generated and armed at runtime by qmanager_scheduled_reboot_arm whenever
# System Settings -> Scheduled Reboot is saved enabled.
